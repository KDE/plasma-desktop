#: kcm.cpp:164
#, kde-format
msgid "None"
msgstr "يوق"

#: kcm.cpp:167
#, kde-format
msgid "No splash screen will be shown"
msgstr "ھېچقانداق مەرھابا ئېكرانى كۆرسىتىلمەيدۇ"

#: kcm.cpp:185
#, kde-format
msgid "You cannot delete the currently selected splash screen"
msgstr "نۆۋەتتە تاللانغان مەرھابا ئېكرانىنى ئۆچۈرەلمەيسىز"

#. i18n: ectx: label, entry (engine), group (KSplash)
#: splashscreensettings.kcfg:12
#, kde-format
msgid "For future use"
msgstr "كەلگۈسىدە ئىشلىتىش ئۈچۈن"

#. i18n: ectx: label, entry (theme), group (KSplash)
#: splashscreensettings.kcfg:16
#, kde-format
msgid "Name of the current splash theme"
msgstr "نۆۋەتتىكى مەرھابا ئۆرنەكنىڭ ئاتى"

#: ui/main.qml:30
#, kde-format
msgctxt "@action:button"
msgid "&Get New…"
msgstr "يېڭىسىغا ئېرىش(&G)…"

#: ui/main.qml:50
#, kde-format
msgctxt "@info:status"
msgid "Failed to show the splash screen preview."
msgstr "مەرھابا ئېكرانىنى ئالدىن كۆزىتىشنى كۆرسىتەلمىدى."

#: ui/main.qml:81
#, kde-format
msgctxt "@info:tooltip"
