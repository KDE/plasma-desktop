#: ui/main.qml:90
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete the active splash screen"
msgstr "ئاكتىپ مەرھابا ئېكرانىنى ئۆچۈرگىلى بولمايدۇ"

#: ui/main.qml:92
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete system-installed splash screens"
msgstr "سىستېما ئورناتقان مەرھابا ئېكرانىنى ئۆچۈرگىلى بولمايدۇ"
