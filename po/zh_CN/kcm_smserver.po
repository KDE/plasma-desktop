#. i18n: ectx: label, entry (confirmLogout), group (General)
#: smserversettings.kcfg:9
#, kde-format
msgid "Confirm logout"
msgstr "确认注销"

#. i18n: ectx: label, entry (shutdownType), group (General)
#: smserversettings.kcfg:13
#, kde-format
msgid "Default leave option"
msgstr "默认退出选项"

#. i18n: ectx: label, entry (loginMode), group (General)
#: smserversettings.kcfg:22
#, kde-format
msgid "On login"
msgstr "登录时"

#. i18n: ectx: label, entry (excludeApps), group (General)
#: smserversettings.kcfg:26
#, kde-format
msgid "Applications to be excluded from session"
msgstr "要从会话中排除的应用程序"

#: ui/main.qml:30
#, kde-format
msgctxt "@info:status inlinemessage"
msgid "Failed to request restart to firmware setup: %1"
msgstr "请求重新启动到固件设置失败：%1"

#: ui/main.qml:31
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"Next time the computer is restarted, it will enter UEFI firmware settings."
msgstr "下次重新启动计算机时，它将进入 UEFI 固件设置。"

#: ui/main.qml:32
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"Next time the computer is restarted, it will enter the firmware setup screen."
msgstr "下次重新启动计算机时，它将进入固件设置。"

#: ui/main.qml:37
#, kde-format
msgctxt "@action:button"
msgid "Restart Now"
msgstr "立即重新启动"

#: ui/main.qml:45
#, kde-format
msgctxt ""
"@label beginning of the logical sentence 'Ask for confirmation on shutdown, "
"restart, and logout.'"
msgid "Ask for confirmation:"
msgstr "请求确认："

#: ui/main.qml:48
#, kde-format
msgctxt ""
"@option:check end of the logical sentence 'Ask for confirmation on shutdown, "
"restart, and logout.'"
msgid "On shutdown, restart, and logout"
msgstr "关机、重启、注销时"

#: ui/main.qml:60
#, kde-format
msgctxt ""
"@label:check part of a sentence: After next restart enter UEFI/Firmware "
"setup screen"
msgid "After next restart:"
msgstr "下次重启时："

#: ui/main.qml:63
#, kde-format
msgctxt "@option:check"
msgid "Enter UEFI firmware settings"
msgstr "进入 UEFI 固件设置"

#: ui/main.qml:64
#, kde-format
msgctxt "@option:check"
msgid "Enter firmware setup screen"
msgstr "进入固件设置屏幕"

#: ui/main.qml:72
#, kde-format
msgctxt "@title:group"
msgid "Session Restore"
msgstr "会话恢复"

#: ui/main.qml:79
#, kde-format
msgctxt "@title:group prefix for radiobuttons"
msgid "On login:"
msgstr ""

#: ui/main.qml:82
#, kde-format
msgctxt "@option:radio Automatic style of session restoration"
msgid "Restore apps from previous session"
msgstr ""

#: ui/main.qml:93
#, kde-format
msgctxt "@info"
msgid ""
"When you log back in, Plasma will automatically reopen applications and "
"windows that were running when you last logged out."
msgstr ""

#: ui/main.qml:101
#, kde-format
msgctxt "@option:radio Manual style of session restoration"
msgid "Restore manually saved session"
msgstr ""

#: ui/main.qml:112
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Adds a <interface>Save Session</interface> button to the "
"<interface>Application Launcher</interface> menu. When you click it, Plasma "
"will remember the open apps and restore them on the next login. Click it "
"again to replace the set of remembered apps."
msgstr ""

#: ui/main.qml:121
#, kde-format
msgctxt "@option:radio"
msgid "Start with an empty session"
msgstr "启动为空会话"

#: ui/main.qml:134
#, kde-format
msgctxt "@action:button"
msgid "Configure Ignored Applications…"
msgstr ""

#: ui/main.qml:148
#, kde-format
msgctxt "@info"
msgid ""
"Prevent specified applications from autostarting with other session-restored "
"apps. Use each application's desktop file identifier (e.g. org.kde.kate."
"desktop) or, for XWayland apps, its executable name (e.g. xterm)."
msgstr ""

#: ui/main.qml:158
#, kde-format
msgctxt "@title:dialog"
msgid "Ignored Applications"
msgstr ""

#: ui/main.qml:171
#, kde-format
msgctxt "@info:placeholder"
msgid "Enter application (e.g. org.kde.kate.desktop or xterm)"
msgstr ""

#: ui/main.qml:177
#, kde-format
msgctxt "@action:button"
msgid "Ignore this Application"
msgstr ""

#: ui/main.qml:179
#, kde-format
msgctxt "@info:whatsthis"
msgid "Add %1 to the list of ignored applications"
msgstr ""

#: ui/main.qml:180
#, kde-format
msgctxt "@info:whatsthis"
msgid "Add an application to the list of ignored applications"
msgstr ""

