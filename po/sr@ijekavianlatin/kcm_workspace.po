#: ui/main.qml:25
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"The system must be restarted before changes to the middle-click paste "
"setting can take effect."
msgstr ""
"Sistem mora da se ponovo pokrene da bi izmjene postavke naljepljivanja "
"srednjim klikom stupile na snagu."

#: ui/main.qml:31
#, kde-format
msgctxt "@action:button"
msgid "Restart"
msgstr "Ponovo pokreni"

#: ui/main.qml:46
#, kde-format
msgctxt "@title:group"
msgid "Plasma"
msgstr "Plasma"

#: ui/main.qml:49
#, kde-format
msgctxt "Part of the sentence 'Allow Plasma to show panel and widget tooltips'"
msgid "Allow Plasma to show:"
msgstr "Dozvoli Plasmi da prikazuje:"

#: ui/main.qml:52
#, kde-format
msgctxt "Part of the sentence 'Allow Plasma to show panel and widget tooltips'"
msgid "Panel and widget tooltips"
msgstr "Oblačiće panela i vidžeta"

#: ui/main.qml:63
#, kde-format
msgctxt "@info:whatsthis contextualhelpbutton tooltip"
msgid ""
"Allows all Plasma panel and desktop widgets to show descriptive tooltips "
"when hovered with the pointer. This setting has no effect on the small "
"tooltips displayed when hovering over individual buttons and other user "
"interface elements."
msgstr ""
"Dozvoljava svim vidžetima panela i površi Plasme da prikazuju opisne "
"oblačiće pri lebdjenju pokazivača. Ova postavka ne utiče na male oblačiće "
"koji se prikazuju pri lebdjenju iznad pojedinačnih dugmadi i drugih "
"elemenata korisničkog sučelja."

#: ui/main.qml:70
#, kde-format
msgctxt ""
"Part of the sentence 'Allow Plasma to show OSD popups for status changes'"
msgid "OSD popups for status changes"
msgstr "Ekranske iskakače pri promjenama stanja"

#: ui/main.qml:81
#, kde-format
msgctxt "@info:whatsthis contextualhelpbutton tooltip"
msgid ""
"Allows all Plasma widgets to show on-screen display (OSD) popups for changes "
"like volume and brightness level, or audio device switching."
msgstr ""
"Dozvoljava svim vidžetima Plasme da prikazuju iskakače ekranskog prikaza "
"(OSD) pri promjenama kao što su jačina zvuka i nivo osvjetljaja, ili "
"prebacivanje audio uređaja."

#: ui/main.qml:88
#, kde-format
msgctxt "@title:group"
msgid "Scrolling"
msgstr "Klizanje"

#: ui/main.qml:92
#, kde-format
msgctxt "@title:group prefix radiobutton group"
msgid "Clicking in scrollbar track:"
msgstr "Klik na stazu klizačke trake:"

#: ui/main.qml:93
#, kde-format
msgctxt ""
"@radio part of a complete sentence: 'Clicking in scrollbar track scrolls to "
"the clicked location'"
msgid "Scrolls to the clicked location"
msgstr "Kliza do kliknutog mjesta"

#: ui/main.qml:111
#, kde-format
msgctxt ""
"@radio part of a complete sentence: 'Clicking in scrollbar track scrolls one "
"page up or down'"
msgid "Scrolls one page up or down"
msgstr "Kliza za stranicu gore ili dolje"

#: ui/main.qml:112
#, kde-format
msgctxt "@info:usagetip"
msgid "Middle-click to scroll to clicked location"
msgstr "Srednji klik kliza do kliknutog mjesta"

#: ui/main.qml:129
#, kde-format
msgctxt "@option:check"
msgid "Prefer smooth scrolling"
msgstr "Daj prednost glatkom klizanju"

#: ui/main.qml:140
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"This setting enables or disables animated transitions when scrolling with a "
"mouse wheel or the keyboard. Some applications may not honor this setting "
"because they either do not support smooth scrolling, or have their own "
"setting for enabling and disabling it."
msgstr ""
"Ova postavka uključuje ili isključuje animirane prelaze pri klizanju "
"točkićem miša ili tastaturom. Neki programi možda neće poštovati ovu "
"postavku, jer ili ne podržavaju glatko klizanje ili imaju sopstvenu postavku "
"za njegovo uključivanje i isključivanje."

#: ui/main.qml:146
#, kde-format
msgctxt "@title:group"
msgid "Clicking"
msgstr "Kliktanje"

#: ui/main.qml:149
#, kde-format
msgctxt ""
"part of a sentence: 'Clicking files or folders [opens them/selects them]'"
msgid "Clicking files or folders:"
msgstr "Klik na fajlove ili fascikle:"

#: ui/main.qml:153
#, kde-format
msgctxt "part of a sentence: 'Clicking files or folders selects them'"
msgid "Selects them"
msgstr "Bira ih"

#: ui/main.qml:154
#, kde-format
msgctxt "@info:usagetip"
msgid "Open by double-clicking instead"
msgstr "Otvarajte ih dvoklikom"

#: ui/main.qml:171
#, kde-format
msgctxt "part of a sentence: 'Clicking files or folders opens them'"
msgid "Opens them"
msgstr "Otvara ih"

#: ui/main.qml:172
#, kde-format
msgctxt "@info:usagetip"
msgid "Select by clicking on item's selection marker"
msgstr "Birajte klikom na marker izbora stavke"

#: ui/main.qml:190
#, kde-format
msgctxt ""
"@label for checkbox, part of a complete sentence: 'Middle-click pastes "
"selected text'"
msgid "Middle-click:"
msgstr "Srednji klik:"

#: ui/main.qml:194
#, kde-format
msgctxt ""
"@option:check part of a complete sentence: 'Middle click pastes selected "
"text'"
msgid "Pastes selected text"
msgstr "Naljepljuje izabrani tekst"

#: ui/main.qml:212
#, kde-format
msgctxt "@label:spinbox"
msgid "Double-click interval:"
msgstr "Period dvoklika:"

#: ui/main.qml:232
#, kde-format
msgctxt "short for millisecond(s)"
msgid "%1 ms"
msgid_plural "%1 ms"
msgstr[0] "%1 ms"
msgstr[1] "%1 ms"
msgstr[2] "%1 ms"
msgstr[3] "%1 ms"

#: ui/main.qml:236
#, kde-format
msgctxt "short for millisecond(s)"
msgid "ms"
msgstr "ms"

#: ui/main.qml:251
#, kde-format
msgctxt "@info:whatsthis contextualhelpbutton tooltip"
msgid ""
"Two clicks within this duration are considered a double-click. Some "
"applications may not honor this setting."
msgstr ""
"Dva klika u okviru ovog perioda smatraju se dvoklikom. Neki programi možda "
"neće poštovati ovu postavku."

#: ui/main.qml:262
#, kde-format
msgctxt "Test double-click speed"
msgid ""
"Double-click the folder to test. If it does not change its appearance, "
"increase double-click interval."
msgstr ""
"Dvokliknite na fasciklu da isprobate. Ako ne promijeni izgled, povećajte "
"period dvoklika."

#: ui/main.qml:306
#, kde-format
msgctxt "@title:group prefix radiobutton group"
msgid "Drag and Drop"
msgstr "Prevlačenje i ispuštanje"

#: ui/main.qml:309
#, kde-format
msgctxt "@title:group prefix radiobutton group"
msgid "When dragging files or folders:"
msgstr "Pri prevlačenju fajlova ili fascikli:"

#: ui/main.qml:313
#, kde-format
msgctxt "@option:radio When dragging..."
msgid "Always ask what to do"
msgstr "Uvijek pitaj šta da se radi"

#: ui/main.qml:314
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Hold <shortcut>Shift</shortcut> to move, <shortcut>Ctrl</shortcut> to copy, "
"and <shortcut>Shift+Ctrl</shortcut> to create a symlink. Otherwise show a "
"dialog."
msgstr ""
"Držite <shortcut>Shift</shortcut> za premiještanje, <shortcut>Ctrl</"
"shortcut> za kopiranje i <shortcut>Shift+Ctrl</shortcut> za pravljenje "
"simboličke veze. Inače se prikazuje dijalog."

#: ui/main.qml:332
#, kde-format
msgctxt "@option:radio When dragging…"
msgid "Move if on the same device"
msgstr "Premjesti ako je na istom uređaju"

#: ui/main.qml:333
#, kde-kuit-format
msgctxt "@info"
msgid "Hold <shortcut>Shift</shortcut> when dropping to show other options."
msgstr ""
"Držite <shortcut>Shift</shortcut> pri ispuštanju da biste vidjeli druge "
"opcije."

#: ui/main.qml:348
#, kde-format
msgctxt "@title:group"
msgid "Touch"
msgstr "Dodir"

#: ui/main.qml:351
#, kde-format
msgctxt "@title:group prefix radiobutton group"
msgid "Enable Tablet Mode:"
msgstr "Uključi režim tableta:"

#: ui/main.qml:354
#, kde-format
msgctxt "As in: 'Tablet Mode is automatically enabled as needed'"
msgid "Automatically enable as needed"
msgstr "Automatski po potrebi"

#: ui/main.qml:354
#, kde-format
msgctxt "As in: 'Tablet Mode is never enabled'"
msgid "Never enabled"
msgstr "Nikad"

#: ui/main.qml:373
#, kde-format
msgctxt "@info:whatsthis contextualhelpbutton tooltip"
msgid ""
"Tablet Mode will be automatically enabled whenever the system detects a "
"touchscreen but no mouse or touchpad. For example: when a transformable "
"laptop's keyboard is flipped around or detached."
msgstr ""
"Režim tableta će se automatski uključiti kad god sistem otkrije ekran na "
"dodir, a nema miša ni dodirnika. Na primjer: kada se tastatura preklopivog "
"laptopa obrne ili otkači."

#: ui/main.qml:379
#, kde-format
msgctxt "As in: 'Tablet Mode is always enabled'"
msgid "Always enabled"
msgstr "Uvijek"

#: ui/main.qml:401
#, kde-format
msgctxt "As in: 'Tablet Mode is never enabled'"
msgid "Disabled"
msgstr "Nikad"

#: ui/main.qml:402
#, kde-format
msgctxt "@info:usagetip"
msgid "In Tablet Mode, the virtual keyboard will appear when needed."
msgstr "U režimu tableta, virtuelna tastatura će se pojaviti po potrebi."

#. i18n: ectx: label, entry (singleClick), group (KDE)
#: workspaceoptions_kdeglobalssettings.kcfg:9
#, kde-format
msgid "Single click to open files"
msgstr "Jedan klik otvara fajlove"

#. i18n: ectx: label, entry (dndBehavior), group (KDE)
#: workspaceoptions_kdeglobalssettings.kcfg:13
#, kde-format
msgid ""
"For local files on the same device, whether dragging and dropping will "
"perform a move operation instead of showing the options menu"
msgstr ""
"Da li će, za lokalne fajlove na istom uređaju, prevlačenje i ispuštanje "
"izvesti premiještanje umjesto prikazivanja menija opcija"

#. i18n: ectx: label, entry (smoothScroll), group (KDE)
#: workspaceoptions_kdeglobalssettings.kcfg:21
#, kde-format
msgid "Smooth scrolling"
msgstr "Glatko klizanje"

#. i18n: ectx: label, entry (scrollbarLeftClickNavigatesByPage), group (KDE)
#: workspaceoptions_kdeglobalssettings.kcfg:25
#, kde-format
msgid "Left-click in scrollbar track moves scrollbar by one page"
msgstr ""
"Lijevi klik na stazu klizačke trake pomijera klizačku traku za stranicu"

#. i18n: ectx: label, entry (doubleClickInterval), group (KDE)
#: workspaceoptions_kdeglobalssettings.kcfg:29
#, kde-format
msgid "Double click interval"
msgstr "Period dvoklika"

#. i18n: ectx: label, entry (tabletMode), group (Input)
#: workspaceoptions_kwinsettings.kcfg:9
#, kde-format
msgid "Automatically switch to touch-optimized mode"
msgstr "Automatski prebacuj u režim prilagođen dodiru"

#. i18n: ectx: label, entry (primarySelection), group (Wayland)
#: workspaceoptions_kwinsettings.kcfg:15
#, kde-format
msgid "Enable middle click selection pasting"
msgstr "Uključi naljepljivanje izbora srednjim klikom"

#. i18n: ectx: label, entry (delay), group (PlasmaToolTips)
#: workspaceoptions_plasmasettings.kcfg:9
#, kde-format
msgid "Display large panel and widget tooltips"
msgstr "Prikaži velike oblačiće panela i vidžeta"

#. i18n: ectx: tooltip, entry (delay), group (PlasmaToolTips)
#: workspaceoptions_plasmasettings.kcfg:10
#, kde-format
msgid ""
"Allow Plasma widgets to display large panel and widget tooltips on hover"
msgstr ""
"Dozvoli vidžetima Plasme da prikazuju velike oblačiće panela i vidžeta pri "
"lebdjenju"

#. i18n: ectx: label, entry (osdEnabled), group (OSD)
#: workspaceoptions_plasmasettings.kcfg:16
#, kde-format
msgid "Display small popups for status changes"
msgstr "Prikaži male iskakače pri promjenama stanja"

#. i18n: ectx: tooltip, entry (osdEnabled), group (OSD)
#: workspaceoptions_plasmasettings.kcfg:17
#, kde-format
msgid ""
"Allow Plasma widgets to display small popups for status changes such as "
"brightness or volume"
msgstr ""
"Dozvoli vidžetima Plasme da prikazuju male iskakače pri promjenama stanja, "
"kao što su osvjetljaj ili jačina zvuka"

#. i18n: ectx: label, entry (osdKbdLayoutChangedEnabled), group (OSD)
#: workspaceoptions_plasmasettings.kcfg:21
#, kde-format
msgid "OSD on layout change"
msgstr "OSD pri promjeni rasporeda"

#. i18n: ectx: tooltip, entry (osdKbdLayoutChangedEnabled), group (OSD)
#: workspaceoptions_plasmasettings.kcfg:22
#, kde-format
msgid "Show a popup on layout changes"
msgstr "Prikaži iskakač pri promjeni rasporeda"
