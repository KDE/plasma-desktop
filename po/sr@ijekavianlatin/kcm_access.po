msgid "Enable"
msgstr "Uključi"

#: ui/ModifierKeys.qml:32
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Modifier keys like Ctrl, Shift, Alt, and the Meta/Super/Windows key act as "
"though they “stick in place” and no longer need to be held down when typing "
"a keyboard shortcut."
msgstr ""
"Modifikatorski tasteri kao što su Ctrl, Shift, Alt i taster Meta/Super/"
"Windows ponašaju se kao da su „zalijepljeni“ i više ne moraju da se drže "
"pritisnuti pri kucanju prečice sa tastature."

#: ui/ModifierKeys.qml:39
#, kde-format
msgctxt "@option:check"
msgid "Lock sticky keys"
msgstr "Zaključaj ljepljive tastere"

#: ui/ModifierKeys.qml:52
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Pressing a modifier key twice will keep it in active state until pressed "
"again."
msgstr ""
"Dvostrukim pritiskom modifikatorski taster ostaje aktivan dok se ponovo ne "
"pritisne."

#: ui/ModifierKeys.qml:60
#, kde-format
msgctxt "@option:check"
msgid "Disable when two keys are held down"
msgstr "Isključi kada se drže pritisnuta dva tastera"

#: ui/ModifierKeys.qml:75
#, kde-format
msgctxt "@option:check"
