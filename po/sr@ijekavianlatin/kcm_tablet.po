#: ui/Calibration.qml:32
#, kde-format
msgctxt "@title"
msgid "Pen Calibration"
msgstr "Kalibracija olovke"

#: ui/Calibration.qml:73
#, kde-format
msgctxt "@info"
msgid "%1: (%2 px, %3 px)"
msgstr "%1: (%2 piks., %3 piks.)"

#: ui/Calibration.qml:107
#, kde-format
msgctxt "@info"
msgid ""
"Applied center correction (%1 px, %2 px). Retap the targets to redo the "
"correction."
msgstr ""
"Primijenjena je korekcija središta (%1 piks., %2 piks.). Ponovo tapnite mete "
"da ponovite korekciju."

#: ui/Calibration.qml:173
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Tap the targets again to confirm the new calibration.<nl/><nl/><emphasis "
"strong='true'>Will revert to default calibration in %1 second unless further "
"action is taken.</emphasis>"
msgid_plural ""
"Tap the targets again to confirm the new calibration.<nl/><nl/><emphasis "
"strong='true'>Will revert to default calibration in %1 seconds unless "
"further action is taken.</emphasis>"
msgstr[0] ""
"Ponovo tapnite mete da potvrdite novu kalibraciju.<nl/><nl/><emphasis "
"strong='true'>Podrazumijevana kalibracija biće vraćena za %1 sekundu ako ne "
"preduzmete nikakvu radnju.</emphasis>"
msgstr[1] ""
"Ponovo tapnite mete da potvrdite novu kalibraciju.<nl/><nl/><emphasis "
"strong='true'>Podrazumijevana kalibracija biće vraćena za %1 sekunde ako ne "
"preduzmete nikakvu radnju.</emphasis>"
msgstr[2] ""
"Ponovo tapnite mete da potvrdite novu kalibraciju.<nl/><nl/><emphasis "
"strong='true'>Podrazumijevana kalibracija biće vraćena za %1 sekundi ako ne "
"preduzmete nikakvu radnju.</emphasis>"
msgstr[3] ""
"Ponovo tapnite mete da potvrdite novu kalibraciju.<nl/><nl/><emphasis "
"strong='true'>Podrazumijevana kalibracija biće vraćena za %1 sekundu ako ne "
"preduzmete nikakvu radnju.</emphasis>"

#: ui/Calibration.qml:177
#, kde-format
msgctxt "@info"
msgid ""
"Calibration is completed and saved.\n"
"\n"
"Tap the center target once to fine-tune alignment. You can retap the other "
"targets to verify the result."
msgstr ""
"Kalibracija je završena i sačuvana.\n"
"\n"
"Tapnite jednom središnju metu da fino podesite poravnanje. Ostale mete "
"možete ponovo tapnuti da provjerite rezultat."

#: ui/Calibration.qml:180
#, kde-format
msgctxt "@info"
msgid "Tap the center of each target."
msgstr "Tapnite središte svake mete."

#: ui/Calibration.qml:201
#, kde-format
msgctxt "@info"
