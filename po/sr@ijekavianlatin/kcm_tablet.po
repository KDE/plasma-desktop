#, kde-format
msgctxt "% of minimum pen pressure"
msgid "%1%"
msgstr "%1%"

#: ui/StylusTab.qml:409
#, kde-format
msgctxt "% of maximum pen pressure"
msgid "%1%"
msgstr "%1%"

#: ui/StylusTab.qml:420
#, kde-format
msgctxt "100% or maximum pen pressure"
msgid "100%"
msgstr "100%"

#: ui/StylusTab.qml:428
#, kde-format
msgctxt "0% or zero pen pressure"
msgid "0%"
msgstr "0%"

#: ui/StylusTab.qml:433
#, kde-format
msgctxt "@info"
msgid ""
"This curve controls the relationship between the pressure on the stylus and "
"the pressure values received by applications."
msgstr ""
"Ova kriva određuje odnos između pritiska na olovku i vrijednosti pritiska "
"koje dobijaju programi."

#: ui/StylusTab.qml:438
#, kde-format
msgctxt "Pen pressure range"
msgid "Pressure Range:"
msgstr "Opseg pritiska:"

#: ui/StylusTab.qml:456
#, kde-format
msgctxt "@info"
msgid ""
"Pressure above or below the threshold will be clamped, and this becomes the "
"new effective range."
msgstr ""
"Pritisak iznad ili ispod praga biće odsječen, i to postaje novi stvarni "
"opseg."

#: ui/StylusTab.qml:461
#, kde-format
msgctxt "@info"
msgid ""
"You have manually calibrated this tablet. If it's no longer working "
"correctly, try resetting this first."
msgstr ""
"Ručno ste kalibrisali ovu tablicu. Ako više ne radi ispravno, prvo pokušajte "
"da resetujete kalibraciju."

