#, kde-format
msgctxt "@option:check Enable left-handed mode"
msgid "Enable"
msgstr "Uključi"

#: ui/StylusTab.qml:241
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Tells the device to accommodate left-handed users. Effects will vary by "
"device, but often it reverses the pad buttonsʼ functionality so the tablet "
"can be used upside-down."
msgstr ""
"Prilagođava uređaj ljevorukim korisnicima. Dejstvo zavisi od uređaja, ali "
"obično se obrću uloge dugmadi podloge, tako da tablica može da se koristi "
"naopako."

#: ui/StylusTab.qml:247
#, kde-format
msgctxt ""
"'Mode' is the mode the stylus is in, pen (absolute) or mouse (relative)"
msgid "Mode:"
msgstr "Režim:"

#: ui/StylusTab.qml:251
#, kde-format
msgctxt ""
"@option:radio Pen mode, where the point on the screen is always where you "
"touch the stylus"
msgid "Pen"
msgstr "Olovka"

# switch-rule: t-cursor > t-pointer
#: ui/StylusTab.qml:256
#, kde-format
msgctxt "@info:whatsthis Accessible description"
msgid "The cursor follows where you touch the pen on the surface"
msgstr "Pokazivač prati mjesto gdje olovkom dodirnete površinu"

#: ui/StylusTab.qml:265
#, kde-format
msgctxt ""
"@option:radio Mouse mode, or like using the tablet like a giant touchpad"
msgid "Mouse"
msgstr "Miš"

# switch-rule: t-cursor > t-pointer
#: ui/StylusTab.qml:270
#, kde-format
msgctxt "@info:whatsthis Accessible description"
msgid ""
"Moving the pen on the surface moves the cursor relative to where it was, "
"like a mouse"
msgstr ""
"Pomijeranje olovke po površini pomijera pokazivač u odnosu na njegov "
"prethodni položaj, kao miš"

#: ui/StylusTab.qml:276
#, kde-format
msgid "Sync with mouse cursor"
msgstr "Uskladi sa pokazivačem miša"

#: ui/StylusTab.qml:345
#, kde-format
msgctxt "@label prefix for pen pressure curve config"
msgid "Pen Pressure:"
msgstr "Pritisak olovke:"

