#: ui/Calibration.qml:32
#, kde-format
msgctxt "@title"
msgid "Pen Calibration"
msgstr "Calibración del lápiz"

#: ui/Calibration.qml:73
#, kde-format
msgctxt "@info"
msgid "%1: (%2 px, %3 px)"
msgstr "%1: (%2 px, %3 px)"

#: ui/Calibration.qml:107
#, kde-format
msgctxt "@info"
msgid ""
"Applied center correction (%1 px, %2 px). Retap the targets to redo the "
"correction."
msgstr ""
"Se ha aplicado corrección del centro (%1 px, %2 px). Vuelva a tocar los "
"objetivos para rehacer la corrección."

#: ui/Calibration.qml:173
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Tap the targets again to confirm the new calibration.<nl/><nl/><emphasis "
"strong='true'>Will revert to default calibration in %1 seconds unless "
"further action is taken.</emphasis>"
msgstr ""
"Toque los puntos de nuevo para confirmar la nueva calibración.<nl/><nl/"
"><emphasis strong='true'>Se volverá a la calibración predeterminada en %1 "
"segundos a menos que realice alguna acción más.</emphasis>"

#: ui/Calibration.qml:177
#, kde-format
msgctxt "@info"
msgid ""
"Calibration is completed and saved.\n"
"\n"
"Tap the center target once to fine-tune alignment. You can retap the other "
"targets to verify the result."
msgstr ""
"La calibración se ha completado y se ha guardado.\n"
"\n"
"Toque el objetivo del centro para afinar la alineación. Puede volver a tocar "
"el resto de objetivos para comprobar el resultado."

#: ui/Calibration.qml:180
#, kde-format
msgctxt "@info"
msgid "Tap the center of each target."
msgstr "Toque el centro de cada punto."

#: ui/Calibration.qml:201
#, kde-format
msgctxt "@info"
msgid ""
"Offset Correction:\n"
"%1"
msgstr ""
"Corrección del desplazamiento:\n"
"%1"

