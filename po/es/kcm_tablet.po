"## Legend:\n"
"# X, Y - event coordinate\n"
"# P - pressure\n"
"# TX,TY - tilt\n"
msgstr ""
"## Leyenda:\n"
"# X, Y: coordenadas del evento\n"
"# P - presión\n"
"# TX,TY - inclinación\n"

