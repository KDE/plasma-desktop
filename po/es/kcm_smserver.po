#. i18n: ectx: label, entry (confirmLogout), group (General)
#: smserversettings.kcfg:9
#, kde-format
msgid "Confirm logout"
msgstr "Confirmar terminar"

#. i18n: ectx: label, entry (shutdownType), group (General)
#: smserversettings.kcfg:13
#, kde-format
msgid "Default leave option"
msgstr "Opción de salida por omisión"

#. i18n: ectx: label, entry (loginMode), group (General)
#: smserversettings.kcfg:22
#, kde-format
msgid "On login"
msgstr "Al iniciar sesión"

#. i18n: ectx: label, entry (excludeApps), group (General)
#: smserversettings.kcfg:26
#, kde-format
msgid "Applications to be excluded from session"
msgstr "Aplicaciones a excluir de la sesión"

#: ui/main.qml:30
#, kde-format
msgctxt "@info:status inlinemessage"
msgid "Failed to request restart to firmware setup: %1"
msgstr ""
"No se ha podido solicitar el reinicio para la configuración del firmware: %1"

#: ui/main.qml:31
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"Next time the computer is restarted, it will enter UEFI firmware settings."
msgstr ""
"La próxima vez que reinicie el equipo, entrará los ajustes del firmware UEFI."

#: ui/main.qml:32
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"Next time the computer is restarted, it will enter the firmware setup screen."
msgstr ""
"La próxima vez que reinicie el equipo, entrará en la pantalla de "
"configuración del firmware."

#: ui/main.qml:37
#, kde-format
msgctxt "@action:button"
msgid "Restart Now"
msgstr "Reiniciar ahora"

#: ui/main.qml:45
#, kde-format
msgctxt ""
"@label beginning of the logical sentence 'Ask for confirmation on shutdown, "
"restart, and logout.'"
msgid "Ask for confirmation:"
msgstr "Solicitar confirmación:"

#: ui/main.qml:48
#, kde-format
msgctxt ""
"@option:check end of the logical sentence 'Ask for confirmation on shutdown, "
"restart, and logout.'"
msgid "On shutdown, restart, and logout"
msgstr "Al apagar, reiniciar y cerrar sesión"

#: ui/main.qml:60
#, kde-format
msgctxt ""
"@label:check part of a sentence: After next restart enter UEFI/Firmware "
"setup screen"
msgid "After next restart:"
msgstr "Tras el siguiente reinicio:"

#: ui/main.qml:63
#, kde-format
msgctxt "@option:check"
msgid "Enter UEFI firmware settings"
msgstr "Entrar en los ajustes del firmware UEFI"

#: ui/main.qml:64
#, kde-format
msgctxt "@option:check"
msgid "Enter firmware setup screen"
msgstr "Entrar en la pantalla de configuración del firmware"

#: ui/main.qml:72
#, kde-format
msgctxt "@title:group"
msgid "Session Restore"
msgstr "Restaurar sesión"

#: ui/main.qml:79
#, kde-format
msgctxt "@title:group prefix for radiobuttons"
msgid "On login:"
msgstr "Al iniciar sesión:"

#: ui/main.qml:82
#, kde-format
msgctxt "@option:radio Automatic style of session restoration"
msgid "Restore apps from previous session"
msgstr "Restaurar las aplicaciones de la sesión anterior"

#: ui/main.qml:93
#, kde-format
msgctxt "@info"
msgid ""
"When you log back in, Plasma will automatically reopen applications and "
"windows that were running when you last logged out."
msgstr ""
"Cuando vuelva a iniciar sesión, Plasma volverá a abrir automáticamente las "
"aplicaciones y las ventanas que estuvieran en ejecución cuando cerró la "
"última sesión."

#: ui/main.qml:101
#, kde-format
msgctxt "@option:radio Manual style of session restoration"
msgid "Restore manually saved session"
msgstr "Restaurar la sesión guardada manualmente"

#: ui/main.qml:112
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Adds a <interface>Save Session</interface> button to the "
"<interface>Application Launcher</interface> menu. When you click it, Plasma "
"will remember the open apps and restore them on the next login. Click it "
"again to replace the set of remembered apps."
msgstr ""
"Añade un botón <interface>Guardar sesión</interface> en el menú del "
"<interface>Lanzador de aplicaciones</interface>. Si lo pulsa, Plasma "
"recordará las aplicaciones que estuvieran abiertas y las restaurará durante "
"el siguiente inicio de sesión. Vuelva a pulsarlo para sustituir el conjunto "
"de aplicaciones que se deben recordar."

#: ui/main.qml:121
#, kde-format
msgctxt "@option:radio"
msgid "Start with an empty session"
msgstr "Empezar con una sesión vacía"

#: ui/main.qml:134
#, kde-format
msgctxt "@action:button"
msgid "Configure Ignored Applications…"
msgstr "Configurar aplicaciones ignoradas…"

#: ui/main.qml:148
#, kde-format
msgctxt "@info"
msgid ""
"Prevent specified applications from autostarting with other session-restored "
"apps. Use each application's desktop file identifier (e.g. org.kde.kate."
"desktop) or, for XWayland apps, its executable name (e.g. xterm)."
msgstr ""
"Evitar que las aplicaciones indicadas se inicien automáticamente con otras "
"aplicaciones restauradas de la sesión. Use el identificador de archivo de "
"escritorio de cada aplicación (por ejemplo, org.kde.kate.desktop) o, para "
"las aplicaciones XWayland, el nombre de su ejecutable (por ejemplo, xterm)."

#: ui/main.qml:158
#, kde-format
msgctxt "@title:dialog"
msgid "Ignored Applications"
msgstr "Aplicaciones ignoradas"

#: ui/main.qml:171
#, kde-format
msgctxt "@info:placeholder"
msgid "Enter application (e.g. org.kde.kate.desktop or xterm)"
msgstr "Introduzca aplicación (por ejemplo, org.kde.kate.desktop o xterm)"

#: ui/main.qml:177
#, kde-format
msgctxt "@action:button"
msgid "Ignore this Application"
msgstr "Ignorar esta aplicación"

#: ui/main.qml:179
#, kde-format
msgctxt "@info:whatsthis"
msgid "Add %1 to the list of ignored applications"
msgstr "Añadir %1 a la lista de aplicaciones ignoradas"

#: ui/main.qml:180
#, kde-format
msgctxt "@info:whatsthis"
msgid "Add an application to the list of ignored applications"
msgstr "Añadir una aplicación a la lista de aplicaciones ignoradas"

#: ui/main.qml:214
#, kde-format
msgctxt "@action:button"
msgid "Remove"
msgstr "Eliminar"

#: ui/main.qml:215
#, kde-format
msgctxt "@info:whatsthis"
msgid "Remove %1 from the list of ignored applications"
msgstr "Eliminar %1 de la lista de aplicaciones ignoradas"
