msgid "Enable"
msgstr "Ενεργοποίηση"

#: ui/MouseNavigation.qml:31
#, kde-kuit-format
msgctxt "@info:tooltip"
msgid ""
"The numpad key <shortcut>5</shortcut> functions as a mouse click, toggled by "
"<shortcut>/</shortcut> for middle click, <shortcut>*</shortcut> for right "
"click and <shortcut>NumLock</shortcut> for left click. The keys <shortcut>2</"
"shortcut>, <shortcut>4</shortcut>, <shortcut>6</shortcut>, and <shortcut>8</"
"shortcut> allow for cardinal movement (down, left, right, and up). The keys "
"<shortcut>1</shortcut>, <shortcut>3</shortcut>, <shortcut>7</shortcut>, and "
"<shortcut>9</shortcut> allow for diagonal movement."
msgstr ""
"Το πλήκτρο <shortcut>5</shortcut> του αριθμητικού πληκτρολογίου λειτουργεί "
"ως κλικ του ποντικιού. Με το <shortcut>/</shortcut> επιλέγετε το μεσαίο "
"κλικ, με το <shortcut>*</shortcut> το δεξί κλικ και με το <shortcut>NumLock</"
"shortcut> το αριστερό κλικ. Τα πλήκτρα <shortcut>2</shortcut>, <shortcut>4</"
"shortcut>, <shortcut>6</shortcut> και <shortcut>8</shortcut> μετακινούν τον "
"δείκτη κάτω, αριστερά, δεξιά και πάνω, αντίστοιχα. Τα πλήκτρα <shortcut>1</"
"shortcut>, <shortcut>3</shortcut>, <shortcut>7</shortcut> και <shortcut>9</"
"shortcut> επιτρέπουν τη διαγώνια μετακίνηση."

