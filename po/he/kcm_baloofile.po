#: package/contents/ui/main.qml:21
#, kde-format
msgid ""
"This module lets you configure the file indexer and search functionality."
msgstr "המודול הזה מאפשר לך להגדיר את מתעד הקבצים במפתח ואת יכולות החיפוש."

#: package/contents/ui/main.qml:58
#, kde-format
msgid ""
"This will disable file searching in KRunner and launcher menus, and remove "
"extended metadata display from all KDE applications."
msgstr ""
"פעולה זו תשבית את חיפוש הקבצים בתפריטי KRunner והמשכר ותסיר תצוגת נתוני־על "
"מורחבת מכל יישומי KDE."

#: package/contents/ui/main.qml:67
#, kde-format
msgid ""
"Do you want to delete the saved index data? %1 of space will be freed, but "
"if indexing is re-enabled later, the entire index will have to be re-created "
"from scratch. This may take some time, depending on how many files you have."
msgstr ""
"לשמור את הנתונים שתועדו במפתח? %1 של נפח יתפנו, אבל אם התיעוד במפתח יופעל "
"שוב בהמשך, יהיה צורך ליצור את כל המפתח מאפס. זה עלול לערוך זמן מה כתלות "
"בכמות הקבצים שיש לך."

#: package/contents/ui/main.qml:69
#, kde-format
msgid "Delete Index Data"
msgstr "מחיקת נתוני מפתח"

#: package/contents/ui/main.qml:89
#, kde-format
msgid "The system must be restarted before these changes will take effect."
msgstr "יש להפעיל את המערכת מחדש לפני שהשינויים האלו ייכנסו לתוקף."

#: package/contents/ui/main.qml:93
#, kde-format
msgctxt "@action:button"
msgid "Restart"
msgstr "הפעלה מחדש"

#: package/contents/ui/main.qml:100
#, kde-format
msgid ""
"File Search helps you quickly locate all your files based on their content."
msgstr "חיפוש קבצים מסייע לך לאתר את כל הקבצים שלך לפי התוכן שלהם במהירות."

#: package/contents/ui/main.qml:107
#, kde-format
msgid "Enable File Search"
msgstr "הפעלת חיפוש קבצים"

#: package/contents/ui/main.qml:122
#, kde-format
msgid "Also index file content"
msgstr "אנדקס גם את תוכן הקבצים"

#: package/contents/ui/main.qml:136
#, kde-format
msgid "Index hidden files and folders"
msgstr "לתעד קבצים ותיקיות נסתרים"

#: package/contents/ui/main.qml:160
#, kde-format
msgid "Status: %1, %2% complete"
msgstr "מצב: %1, %2% הושלמו"

#: package/contents/ui/main.qml:165
#, kde-format
msgid "Pause Indexer"
msgstr "עצירת המתעד"

#: package/contents/ui/main.qml:165
#, kde-format
msgid "Resume Indexer"
msgstr "המשך המתעד"

#: package/contents/ui/main.qml:178
#, kde-format
msgid "Currently indexing: %1"
msgstr "מתועד במפתח כעת: %1"

#: package/contents/ui/main.qml:183
#, kde-format
msgid "Folder specific configuration:"
msgstr "להגדרות מסוימות:"

#: package/contents/ui/main.qml:213
#, kde-format
msgid "Start indexing a folder…"
msgstr "התחלת תיעוד תיקייה…"

#: package/contents/ui/main.qml:224
#, kde-format
msgid "Stop indexing a folder…"
msgstr "עצירת תיעוד תיקייה…"

#: package/contents/ui/main.qml:275
#, kde-format
msgid "Not indexed"
msgstr "לא במפתח"

#: package/contents/ui/main.qml:276
#, kde-format
msgid "Indexed"
msgstr "מתועד במפתח"

#: package/contents/ui/main.qml:306
#, kde-format
msgid "Delete entry"
msgstr "מחיקת רשומה"

#: package/contents/ui/main.qml:321
#, kde-format
msgid "Select a folder to include"
msgstr "נא לבחור תיקייה להכללה"

#: package/contents/ui/main.qml:321
#, kde-format
msgid "Select a folder to exclude"
msgstr "נא לבחור תיקייה להחרגה"

