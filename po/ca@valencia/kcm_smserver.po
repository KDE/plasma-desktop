#. i18n: ectx: label, entry (confirmLogout), group (General)
#: smserversettings.kcfg:9
#, kde-format
msgid "Confirm logout"
msgstr "Confirma l'eixida"

#. i18n: ectx: label, entry (shutdownType), group (General)
#: smserversettings.kcfg:13
#, kde-format
msgid "Default leave option"
msgstr "Opció predeterminada d'eixida"

#. i18n: ectx: label, entry (loginMode), group (General)
#: smserversettings.kcfg:22
#, kde-format
msgid "On login"
msgstr "En connectar-se"

#. i18n: ectx: label, entry (excludeApps), group (General)
#: smserversettings.kcfg:26
#, kde-format
msgid "Applications to be excluded from session"
msgstr "Aplicacions que s'exclouran de la sessió"

#: ui/main.qml:30
#, kde-format
msgctxt "@info:status inlinemessage"
msgid "Failed to request restart to firmware setup: %1"
msgstr ""
"Ha fallat mentre se sol·licitava un reinici a la configuració del "
"microprogramari: %1"

#: ui/main.qml:31
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"Next time the computer is restarted, it will enter UEFI firmware settings."
msgstr ""
"La pròxima vegada que es reinicie l'ordinador, entrarà a la configuració del "
"microprogramari UEFI."

#: ui/main.qml:32
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"Next time the computer is restarted, it will enter the firmware setup screen."
msgstr ""
"La pròxima vegada que es reinicie l'ordinador, presentarà la configuració "
"del microprogramari."

#: ui/main.qml:37
#, kde-format
msgctxt "@action:button"
msgid "Restart Now"
msgstr "Reinicia ara"

#: ui/main.qml:45
#, kde-format
msgctxt ""
"@label beginning of the logical sentence 'Ask for confirmation on shutdown, "
"restart, and logout.'"
msgid "Ask for confirmation:"
msgstr "Demana confirmació:"

#: ui/main.qml:48
#, kde-format
msgctxt ""
"@option:check end of the logical sentence 'Ask for confirmation on shutdown, "
"restart, and logout.'"
msgid "On shutdown, restart, and logout"
msgstr "En parar, reiniciar i eixir"

#: ui/main.qml:60
#, kde-format
msgctxt ""
"@label:check part of a sentence: After next restart enter UEFI/Firmware "
"setup screen"
msgid "After next restart:"
msgstr "Després del reinici següent:"

#: ui/main.qml:63
#, kde-format
msgctxt "@option:check"
msgid "Enter UEFI firmware settings"
msgstr "Entra a la configuració del microprogramari UEFI"

#: ui/main.qml:64
#, kde-format
msgctxt "@option:check"
msgid "Enter firmware setup screen"
msgstr "Entra a la pantalla de configuració del microprogramari"

#: ui/main.qml:72
#, kde-format
msgctxt "@title:group"
msgid "Session Restore"
msgstr "Restauració de la sessió"

#: ui/main.qml:79
#, kde-format
msgctxt "@title:group prefix for radiobuttons"
msgid "On login:"
msgstr "En connectar-se:"

#: ui/main.qml:82
#, kde-format
msgctxt "@option:radio Automatic style of session restoration"
msgid "Restore apps from previous session"
msgstr "Restaura les aplicacions de la sessió anterior"

#: ui/main.qml:93
#, kde-format
msgctxt "@info"
msgid ""
"When you log back in, Plasma will automatically reopen applications and "
"windows that were running when you last logged out."
msgstr ""
"Quan torneu a iniciar la sessió, Plasma tornarà a obrir automàticament les "
"aplicacions i finestres que s'estaven executant quan vau tancar la sessió."

#: ui/main.qml:101
#, kde-format
msgctxt "@option:radio Manual style of session restoration"
msgid "Restore manually saved session"
msgstr "Restaura manualment la sessió guardada"

#: ui/main.qml:112
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Adds a <interface>Save Session</interface> button to the "
"<interface>Application Launcher</interface> menu. When you click it, Plasma "
"will remember the open apps and restore them on the next login. Click it "
"again to replace the set of remembered apps."
msgstr ""
"Afig un botó <interface>Guarda la sessió</interface> en el menú de "
"l'<interface>Iniciador d'aplicacions</interface>. Quan hi cliqueu, Plasma "
"recordarà les aplicacions obertes i les restaurarà en iniciar la sessió "
"següent. Cliqueu-hi una altra vegada per a substituir el conjunt "
"d'aplicacions recordades."

#: ui/main.qml:121
#, kde-format
msgctxt "@option:radio"
msgid "Start with an empty session"
msgstr "Comença amb una sessió buida"

#: ui/main.qml:134
#, kde-format
msgctxt "@action:button"
msgid "Configure Ignored Applications…"
msgstr "Configureu les aplicacions ignorades…"

#: ui/main.qml:148
#, kde-format
msgctxt "@info"
msgid ""
"Prevent specified applications from autostarting with other session-restored "
"apps. Use each application's desktop file identifier (e.g. org.kde.kate."
"desktop) or, for XWayland apps, its executable name (e.g. xterm)."
msgstr ""
"Evita que les aplicacions especificades comencen automàticament amb altres "
"aplicacions restaurades per sessió. Utilitzeu l'identificador del fitxer "
"«desktop» de cada aplicació (p. ex., org.kde.kate.desktop) o, per a les "
"aplicacions XWayland, el seu nom executable (p. ex., xterm)."

#: ui/main.qml:158
#, kde-format
msgctxt "@title:dialog"
msgid "Ignored Applications"
msgstr "Aplicacions ignorades"

#: ui/main.qml:171
#, kde-format
msgctxt "@info:placeholder"
msgid "Enter application (e.g. org.kde.kate.desktop or xterm)"
msgstr "Introduïu l'aplicació (p. ex., org.kde.kate.desktop o xterm)"

#: ui/main.qml:177
#, kde-format
msgctxt "@action:button"
msgid "Ignore this Application"
msgstr "Ignora esta aplicació"

#: ui/main.qml:179
#, kde-format
msgctxt "@info:whatsthis"
msgid "Add %1 to the list of ignored applications"
msgstr "Afig %1 a la llista d'aplicacions ignorades"

#: ui/main.qml:180
#, kde-format
msgctxt "@info:whatsthis"
msgid "Add an application to the list of ignored applications"
msgstr "Afig una aplicació a la llista d'aplicacions ignorades"

#: ui/main.qml:214
#, kde-format
msgctxt "@action:button"
msgid "Remove"
msgstr "Elimina"

#: ui/main.qml:215
#, kde-format
msgctxt "@info:whatsthis"
msgid "Remove %1 from the list of ignored applications"
msgstr "Elimina %1 de la llista d'aplicacions ignorades"
