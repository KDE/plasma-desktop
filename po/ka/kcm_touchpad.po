#: kcm.cpp:57
#, kde-format
msgid "Not able to select appropriate backend"
msgstr "შესაბამისი უკანაბოლოს არჩევა შეუძლებელია"

#: kcm.cpp:103
#, kde-format
msgid ""
"Error while loading values. See logs for more information. Please restart "
"this configuration module."
msgstr ""
"მნიშვნელობების ჩატვირთვის შეცდომა. მეტი ინფორმაციის მისაღებად იხილეთ "
"ჟურნალი. საჭიროა ამ კონფიგურაციის მოდულის გადატვირთვა."

#: kcm.cpp:106
#, kde-format
msgid "No pointer device found. Connect now."
msgstr "მაჩვენებელი მოწყობილობა აღმოჩენილი არაა. შეაერთეთ ის ახლა."

#: kcm.cpp:115
#, kde-format
msgid ""
"Not able to save all changes. See logs for more information. Please restart "
"this configuration module and try again."
msgstr ""
"ყველა ცვლილების შენახვა შეუძლებელია. მეტი ინფორმაციისთვის იხილეთ ჟურნალი. "
"გადატვირთეთ ეს მოდული და თავიდან სცადეთ."

#: kcm.cpp:134
#, kde-format
msgid ""
"Error while loading default values. Failed to set some options to their "
"default values."
msgstr ""
"ნაგულისხმევი მნიშვნელობების ჩატვირთვის შეცდომა. ზოგიერთი პარამეტრის მათ "
"ნაგულისხმევ მნიშვნელობებზე დაყენების შეცდომა."

#: kcm.cpp:149
#, kde-format
msgid ""
"Error while adding newly connected device. Please reconnect it and restart "
"this configuration module."
msgstr ""
"შეცდომა ახლად შეერთებული მოწყობილობის დამატებისას. თავიდან მიაერთეთ ის და ეს "
"მოდული თავიდან გაუშვით."

#: kcm.cpp:162
#, kde-format
msgid "Pointer device disconnected. Closed its setting dialog."
msgstr "მაჩვენებელი მოწყობილობა გაითიშა. მისი პარამეტრების ფანჯარა დაიხურა."

#: kcm.cpp:164
#, kde-format
msgid "Pointer device disconnected. No other devices found."
msgstr "მაჩვენებელი მოწყობილობა გაითიშა. სხვა მოწყობილობები აღმოჩენილი არაა."

#: kwinwaylandbackend.cpp:45
#, kde-format
msgid "Critical error on reading fundamental device infos for touchpad %1."
msgstr ""
"კრიტიკული შეცდომა მოწყობილობის ფუნდამენტალური ინფორმაციის წაკითხვისას "
"სენსორული პანელისთვის %1."

#: ui/main.qml:69
#, kde-format
msgctxt "@info:status placeholdermessage text"
msgid "No touchpad found"
msgstr "სენსორული პანელი ვერ ვიპოვე"

#: ui/main.qml:70
#, kde-format
msgctxt "@info:usagetip placeholdermessage explanation"
msgid "Connect an external touchpad"
msgstr "გარე სენსორული პანელის მიერთება"

#: ui/main.qml:87
#, kde-format
msgctxt "@label:listbox device selection"
msgid "Device:"
msgstr "მოწყობილობა:"

#: ui/main.qml:110
#, kde-format
msgctxt "@title:group prefix for checkbox group"
msgid "General:"
msgstr "ზოგადი:"

#: ui/main.qml:111
#, kde-format
msgctxt "@option:check"
msgid "Enable device"
msgstr "მოწყობილობის ჩართვა"

#: ui/main.qml:126
#, kde-format
msgctxt "@option:check"
msgid "Disable while mouse is connected"
msgstr "გამორთვა, როცა თაგუნა შეერთებულია"

#: ui/main.qml:146
#, kde-format
msgctxt "option:check"
msgid "Disable while typing"
msgstr "კრეფისას გამორთვა"

#: ui/main.qml:147
#, kde-format
msgctxt "@label 'this' refers to the 'disable touchpad while typing' feature"
msgid "This can interfere with video games."
msgstr "ამას ვიდეოთამაშებში ჩარევა შეუძლია."

#: ui/main.qml:169
#, kde-format
msgctxt "@title:group"
msgid "Left and right buttons:"
msgstr "მარჯვენა და მარცხენა ღილაკები:"

#: ui/main.qml:170
#, kde-format
msgctxt "@option:check"
msgid "Swap (left-handed mode)"
msgstr "მიმოცვლა (ცაციის რეჟიმი)"

#: ui/main.qml:188
#, kde-format
msgctxt "@option:check 'both' refers to the left and right buttons'"
msgid "Press both simultaneously to middle-click"
msgstr "შუა წკაპისთვის ორივე ღილაკს ერთდროულად დააწექით"

#: ui/main.qml:201
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Activating this setting increases click latency by 50ms. The extra delay is "
"needed to correctly detect simultaneous left and right button presses."
msgstr ""
"ამ პარამეტრის გააქტიურება თაგუნას წკაპის დაყოვნებას 50მწმ-ით ზრდის. "
"დამატებითი დაყოვნება საჭიროა, რომ თაგუნას მარჯვენა და მარცხენა ღილაკების "
"ერთდროული დაწკაპუნება სწორად ამოვიცნო."

#: ui/main.qml:202
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"This setting is not available while “Right-click by pressing anywhere with "
"two fingers” is selected."
msgstr ""
"ეს პარამეტრი ხელმიუწვდომელია, სანამ ჩართულია \"მარჯვენა წკაპი ნებისმიერ "
"ადგილას ორი თითით დაჭერისას\"."

#: ui/main.qml:212
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Pointer speed:"
msgstr "კურსორის სიჩქარე:"

#: ui/main.qml:292
#, kde-format
msgctxt "@option:check"
msgid "Enable pointer acceleration"
msgstr "კურსორის აჩქარების ჩართვა"

#: ui/main.qml:304
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"When enabled, pointer travel distance increases with faster movement speed."
msgstr ""
"როცა ჩართულია, კურსორის გადაადგილების მანძილი იზრდება კურსორის სიჩქარესთან "
"ერთად."

#: ui/main.qml:315
#, kde-format
msgctxt "@label:slider"
msgid "Scrolling speed:"
msgstr "გადახვევის სიჩქარე:"

#: ui/main.qml:397
#, kde-format
msgctxt "@item:inrange Slower Scroll"
msgid "Slower"
msgstr "უფრო ნელა"

#: ui/main.qml:404
#, kde-format
msgctxt "@item:inrange Faster Scroll Speed"
msgid "Faster"
msgstr "უფრო სწრაფად"

#: ui/main.qml:411
#, kde-format
msgctxt ""
"@title group begins the sentence 'Scroll by moving two fingers anywhere/"
"moving one finger on edge'"
msgid "Scroll by:"
msgstr "გადახვევა რით:"

#: ui/main.qml:414
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'Scroll by moving two fingers anywhere'"
msgid "Moving two fingers anywhere"
msgstr "ორი თითის მოძრაობა სადმე"

#: ui/main.qml:432
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'Scroll by moving one finger on edge'"
msgid "Moving one finger on edge"
msgstr "წიბოზე ერთი თითის მოძრაობა"

#: ui/main.qml:441
#, kde-format
msgctxt "@option:check"
msgid "Invert scroll direction (Natural scrolling)"
msgstr "გადახვევის მიმართულების ინვერსია (ჩვეულებრივი გადახვევა)"

#: ui/main.qml:458
#, kde-format
msgctxt "@option:check"
msgid "Disable horizontal scrolling"
msgstr "ჰორიზონტალური გადახვევის გამორთვა"

#: ui/main.qml:476
#, kde-format
msgctxt ""
"@title:group for radiobutton group, begins the sentence 'right-click by "
"pressing bottom-right corner/pressing with two fingers'"
msgid "Right-click by:"
msgstr "მარჯვენა წკაპი რით:"

#: ui/main.qml:482
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing bottom-left "
"corner'"
msgid "Pressing bottom-left corner"
msgstr "დაჭერა ქვედა-მარცხენა კუთხეში"

#: ui/main.qml:483
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing bottom-right "
"corner'"
msgid "Pressing bottom-right corner"
msgstr "დაჭერა ქვედა-მარჯვენა კუთხეში"

#: ui/main.qml:489
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing both bottom corners."
msgstr "შუა წკაპი ორივე ქვედა კუთხეში დაჭერით."

#: ui/main.qml:490
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing bottom center."
msgstr "შუა წკაპი ქვედა ცენტრში დაჭერით."

#: ui/main.qml:512
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing with two "
"fingers'"
msgid "Pressing anywhere with two fingers"
msgstr "ნებისმიერ ადგილას დაწოლა ორი თითით"

#: ui/main.qml:513
#, kde-format
msgctxt "@info shown below radio button"
msgid "Middle-click by pressing anywhere with three fingers."
msgstr "შუა წკაპი სამი თითით დაწოლით ნებისმიერ ადგილას."

#: ui/main.qml:530
#, kde-format
msgctxt "@label for checkbox, tap-to-click"
msgid "Tapping:"
msgstr "დატყაპუნება:"

#: ui/main.qml:531
#, kde-format
msgctxt "@option:check"
msgid "Tap to click"
msgstr "დატყაპუნება დასაწკაპუნებლად"

#: ui/main.qml:546
#, kde-format
msgctxt "@option:check"
msgid "Allow dragging after tapping"
msgstr "დატყაპუნების შემდეგ გადათრევის დაშვება"

#: ui/main.qml:558
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Tap, then tap and immediately slide finger over the touchpad to drag. Lift "
"finger to drop."
msgstr ""
"გადასათრევად დაატყაპუნეთ, შემდეგ კი დაატყაპუნეთ და თითი დაუყოვნებლივ "
"გაასრიალეთ სენსორული პანელზე. დასაგდებად აუშვით თითი."

#: ui/main.qml:565
#, kde-format
msgctxt "@option:check"
msgid "Allow briefly lifting finger during tap-and-drag"
msgstr "დატყაპუნება-გადათრევისას თითის ცოტა ხნით აწევის დაშვება"

#: ui/main.qml:578
#, kde-format
msgctxt "@title:group"
msgid "Two-finger tap:"
msgstr "ორი თითით დატყაპუნება:"

#: ui/main.qml:583
#, kde-format
msgctxt "@option:radio"
msgid "Right-click"
msgstr "მარჯვენა წკაპი"

#: ui/main.qml:586
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by tapping anywhere with three fingers."
msgstr "შუა წკაპი სამი თითით დატყაპუნებით ნებისმიერ ადგილას."

#: ui/main.qml:608
#, kde-format
msgctxt "@option:radio"
msgid "Middle-click"
msgstr "შუა წკაპი"

#: ui/main.qml:611
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Right-click by tapping anywhere with three fingers."
msgstr "მარჯვენა წკაპი სამი თითით დატყაპუნებით ნებისმიერ ადგილას."
