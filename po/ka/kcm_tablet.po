msgctxt "@info:whatsthis Accessible description"
msgid "The cursor follows where you touch the pen on the surface"
msgstr "კურსორი მიჰყვება, სადაც კალამს ზედაპირზე შეახებთ"

#: ui/StylusTab.qml:265
#, kde-format
msgctxt ""
"@option:radio Mouse mode, or like using the tablet like a giant touchpad"
msgid "Mouse"
msgstr "თაგუნა"

#: ui/StylusTab.qml:270
#, kde-format
msgctxt "@info:whatsthis Accessible description"
msgid ""
"Moving the pen on the surface moves the cursor relative to where it was, "
"like a mouse"
msgstr ""
"ზედაპირზე კალმის გადაადგილებისას კურსორი მიჰყვება, როგორც თაგუნას შემთხვევაში"

#: ui/StylusTab.qml:276
#, kde-format
msgid "Sync with mouse cursor"
msgstr "სინქრონიზაცია თაგუნას კურსორთან"

#: ui/StylusTab.qml:345
#, kde-format
msgctxt "@label prefix for pen pressure curve config"
msgid "Pen Pressure:"
msgstr "კალმის წნევა:"

#: ui/StylusTab.qml:401
#, kde-format
msgctxt "% of minimum pen pressure"
msgid "%1%"
msgstr "%1%"

#: ui/StylusTab.qml:409
#, kde-format
msgctxt "% of maximum pen pressure"
msgid "%1%"
msgstr "%1%"

#: ui/StylusTab.qml:420
#, kde-format
msgctxt "100% or maximum pen pressure"
msgid "100%"
msgstr "100%"

#: ui/StylusTab.qml:428
#, kde-format
msgctxt "0% or zero pen pressure"
msgid "0%"
msgstr "0%"

#: ui/StylusTab.qml:433
#, kde-format
msgctxt "@info"
msgid ""
"This curve controls the relationship between the pressure on the stylus and "
"the pressure values received by applications."
msgstr ""
"ეს მრუდი აკონტროლებს ურთიერთობას სტილუსის წნევასა და პროგრამების მიერ "
"მიღებულ წნევის მნიშვნელობებს შორის."

#: ui/StylusTab.qml:438
#, kde-format
msgctxt "Pen pressure range"
msgid "Pressure Range:"
msgstr "წნევის შუალედი:"

#: ui/StylusTab.qml:456
#, kde-format
msgctxt "@info"
msgid ""
"Pressure above or below the threshold will be clamped, and this becomes the "
"new effective range."
msgstr ""
"ზღვრის ქვემოთ ან ზემოთ წნევა გაიწელება და ეს ახალი ეფექტური შუალედი გახდება."

#: ui/StylusTab.qml:461
#, kde-format
msgctxt "@info"
msgid ""
"You have manually calibrated this tablet. If it's no longer working "
"correctly, try resetting this first."
msgstr ""
"თქვენ ამ ტაბლეტის კალიბრაცია ხელით მოახდინეთ. თუ ის სწორად აღარ მუშაობს, "
"სცადეთ, ჩამოყაროთ ის."

#: ui/StylusTab.qml:470
#, kde-format
msgctxt "@action:button Calibration in progress"
msgid "Calibration in Progress"
msgstr "კალიბრაციის მიმდინარეობა"

#: ui/StylusTab.qml:472
#, kde-format
msgctxt "@action:button Calibrate the pen display"
msgid "Calibrate"
msgstr "კალიბრაცია"

#: ui/StylusTab.qml:475
#, kde-format
msgctxt "@action:button Pen display doesn't support calibration"
msgid "Calibration Not Supported"
msgstr "კალიბრაცია მხარდაჭერილი არაა"

#: ui/StylusTab.qml:516
#, kde-format
msgctxt "@action:button"
msgid "Reset Custom Calibration"
msgstr "მორგებული კალიბრაციის ჩამოყრა"

#: ui/Tester.qml:25
#, kde-format
msgctxt "@title"
msgid "Tablet Tester"
msgstr "ტაბლეტის შემმოწმებელი"

#: ui/Tester.qml:48
#, kde-format
msgctxt ""
"A tablet stylus was pressed onto the surface X=[x position] Y=[y position]"
msgid "Stylus press X=%1 Y=%2"
msgstr "სტილუსის დაჭერის X=%1 Y=%2"

#: ui/Tester.qml:58
#, kde-format
msgctxt ""
"A tablet stylus has 'released' or was lifted from the surface X=[x position] "
"Y=[y position]"
msgid "Stylus release X=%1 Y=%2"
msgstr "სტილუსის აშვების X=%1 Y=%2"

#: ui/Tester.qml:68
#, kde-format
msgctxt ""
"A tablet stylus has moved over the surface X=[x position] Y=[y position] "
"P=[pressure] TX=[tilt x] TY=[tilt y]"
msgid "Stylus move X=%1 Y=%2 P=%3% TX=%4 TY=%5"
msgstr "სტილუსის გადაადგილების X=%1 Y=%2 P=%3% TX=%4 TY=%5"

#: ui/Tester.qml:75
#, kde-format
msgctxt "A tablet pad's button has been pressed B=[the button number]"
msgid "Pad button press B=%1"
msgstr "პადის ღილაკის დაჭერა B=%1"

#: ui/Tester.qml:77
#, kde-format
msgctxt "A tablet pad's button has been released B=[the button number]"
msgid "Pad button release B=%1"
msgstr "პადის ღილაკის გაშვება B=%1"

#: ui/Tester.qml:83
#, kde-format
msgctxt ""
"A tablet pad's dial has moved, V120 here refers to 'Value 120' which is a "
"technical term that should be kept as is"
msgid "Pad dial moved V120=%1"
msgstr "პადის ღილაკი გადატანილია V120=%1"

#: ui/Tester.qml:219
#, kde-format
msgctxt "The tablet tester legend which is shown on start-up"
msgid ""
"## Legend:\n"
"# X, Y - event coordinate\n"
"# P - pressure\n"
"# TX,TY - tilt\n"
msgstr ""
"## ახსნა:\n"
"# X, Y - მოვლენის კოორდინატები\n"
"# P - წნევა\n"
"# TX, TY - დახრა\n"

#: ui/Tester.qml:225
#, kde-format
msgctxt "Clear the tablet tester event log"
msgid "Clear"
msgstr "გასუფთავება"

