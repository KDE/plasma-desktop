#: inputbackend.cpp:49
#, kde-format
msgid "Critical error on reading fundamental device infos of %1."
msgstr "Kritična greška pri čitanju osnovnih podataka uređaja %1."

#: kcm.cpp:112
#, kde-format
msgid ""
"Error while loading values. See logs for more information. Please restart "
"this configuration module."
msgstr ""
"Greška pri učitavanju vrednosti. Pogledajte dnevnik za više detalja. "
"Pokrenite ponovo ovaj postavni modul."

#: kcm.cpp:115
#, kde-format
msgid "No pointer device found. Connect now."
msgstr "Nema nijednog pokazivačkog uređaja. Povežite ga sada."

#: kcm.cpp:124
#, kde-format
msgid ""
"Not able to save all changes. See logs for more information. Please restart "
"this configuration module and try again."
msgstr ""
"Ne mogu da sačuvam sve izmene. Pogledajte dnevnik za više detalja. Pokrenite "
"ponovo ovaj postavni modul pa pokušajte još opet."

#: kcm.cpp:142
#, kde-format
msgid ""
"Error while loading default values. Failed to set some options to their "
"default values."
msgstr ""
"Greška pri učitavanju podrazumevanih vrednosti. Neke od opcija ne mogu da se "
"postave na podrazumevane vrednosti."

#: kcm.cpp:157
#, kde-format
msgid ""
"Error while adding newly connected device. Please reconnect it and restart "
"this configuration module."
msgstr ""
"Greška pri dodavanju novog povezanog uređaja. Povežite ga opet i pokrenite "
"ponovo ovaj postavni modul."

#: kcm.cpp:170
#, kde-format
msgid "Pointer device disconnected. Closed its setting dialog."
msgstr "Pokazivački uređaj je otkačen. Njegov dijalog postavki je zatvoren."

#: kcm.cpp:172
#, kde-format
msgid "Pointer device disconnected. No other devices found."
msgstr "Pokazivački uređaj je otkačen. Nema drugih uređaja."

#: ui/bindings.qml:27
#, kde-format
msgctxt "@title"
msgid "Extra Mouse Buttons"
msgstr "Dodatna dugmad miša"

#: ui/bindings.qml:77
#, kde-format
msgctxt "@label for assigning an action to a numbered button"
msgid "Extra Button %1:"
msgstr "Dodatno dugme %1:"

#: ui/bindings.qml:106
#, kde-format
msgctxt "@action:button"
msgid "Press the mouse button for which you want to add a key binding"
msgstr "Pritisnite dugme miša kome želite da dodelite svezu tastera"

#: ui/bindings.qml:108
#, kde-format
msgctxt "@action:button, %1 is the translation of 'Extra Button %1' from above"
msgid "Enter the new key combination for %1"
msgstr "Unesite novu kombinaciju tastera za %1"

#: ui/bindings.qml:112
#, kde-format
msgctxt "@action:button"
msgid "Cancel"
msgstr "Odustani"

#: ui/bindings.qml:130
#, kde-format
msgctxt "@action:button"
msgid "Press a mouse button"
msgstr "Pritisni dugme miša"

#: ui/bindings.qml:131
#, kde-format
msgctxt "@action:button, Bind a mousebutton to keyboard key(s)"
msgid "Add Binding…"
msgstr "Dodaj svezu…"

#: ui/main.qml:37
#, kde-format
msgctxt "@action:button"
msgid "Configure Extra Buttons…"
msgstr "Podesi dodatnu dugmad…"

#: ui/main.qml:64
#, kde-format
msgctxt "@title:listbox select device"
msgid "Device:"
msgstr "Uređaj:"

#: ui/main.qml:86
#, kde-format
msgctxt "@title:group"
msgid "General:"
msgstr "Opšte:"

#: ui/main.qml:87
#, kde-format
msgctxt "@option:check enable this mouse device"
msgid "Enable device"
msgstr "Uključi uređaj"

#: ui/main.qml:102
#, kde-format
msgctxt "@title:group"
msgid "Left and right buttons:"
msgstr "Levo i desno dugme:"

#: ui/main.qml:103
#, kde-format
msgctxt "@option:check Left and right buttons"
msgid "Swap (left-handed mode)"
msgstr "Zameni (režim za levoruke)"

#: ui/main.qml:118
#, kde-format
msgctxt "@option:check 'both' refers to the left and right buttons'"
msgid "Press both simultaneously to middle-click"
msgstr "Pritisni oba istovremeno za srednji klik"

#: ui/main.qml:130
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Activating this setting increases click latency by 50ms. The extra delay is "
"needed to correctly detect simultaneous left and right button presses."
msgstr ""
"Uključivanje ove postavke produžava kašnjenje klika za 50 ms. Dodatno "
"kašnjenje je potrebno da bi se ispravno otkrili istovremeni pritisci levog i "
"desnog dugmeta."

#: ui/main.qml:142
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Pointer speed:"
msgstr "Brzina pokazivača:"

#: ui/main.qml:223
#, kde-format
msgctxt "@option:check"
msgid "Enable pointer acceleration"
msgstr "Uključi ubrzanje pokazivača"

#: ui/main.qml:235
#, kde-format
msgctxt "@info:whatsthis ContextualHelpButton tooltip"
msgid ""
"When enabled, pointer travel distance increases with faster movement speed."
msgstr "Kad je uključeno, pokazivač prelazi veći put što je pokret brži."

#: ui/main.qml:264
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Scrolling speed:"
msgstr "Brzina klizanja:"

#: ui/main.qml:328
#, kde-format
msgctxt "Slower Scroll"
msgid "Slower"
msgstr "sporije"

#: ui/main.qml:337
#, kde-format
msgctxt "Faster Scroll Speed"
msgid "Faster"
msgstr "brže"

#: ui/main.qml:347
#, kde-format
msgctxt "@title:group"
msgid "Scrolling:"
msgstr "Klizanje:"

#: ui/main.qml:348
#, kde-format
msgctxt "@option:check"
msgid "Invert scroll direction"
msgstr "Obrni smer klizanja"

#: ui/main.qml:363
#, kde-format
msgctxt "@option:check"
msgid "Scroll when moving the pointer"
msgstr "Klizaj pri pomeranju pokazivača"

#: ui/main.qml:383
#, kde-format
msgctxt "@option:radio"
msgid "while pressing the middle button"
msgstr "dok je pritisnuto srednje dugme"

#: ui/main.qml:396
#, kde-format
msgctxt "@info:whatsthis ContextualHelpButton tooltip"
msgid ""
"This will interfere with applications that use middle-button drag, such as "
"some image editors, document viewers, or video games. It may be used on any "
"device, but is intended primarily as a substitute for scroll wheels on "
"devices that do not have any."
msgstr ""
"Ovo će smetati programima koji koriste prevlačenje srednjim dugmetom, poput "
"nekih uređivača slika, prikazivača dokumenata ili video igara. Može se "
"koristiti na svakom uređaju, ali je prvenstveno namenjeno kao zamena za "
"točkić na uređajima koji ga nemaju."

#: ui/main.qml:406
#, kde-format
msgctxt "@option:radio"
msgid "after clicking the middle button"
msgstr "posle klika srednjim dugmetom"

#: ui/main.qml:419
#, kde-format
msgctxt "@info:whatsthis ContextualHelpButton tooltip"
msgid ""
"This will interfere with middle-clicks in general; middle-click twice when "
"you want the application to receive a single middle-click. This includes "
"middle-click dragging."
msgstr ""
"Ovo će smetati svim srednjim klikovima; kliknite srednjim dugmetom dvaput "
"kada želite da program primi jedan srednji klik. To važi i za prevlačenje "
"srednjim klikom."
