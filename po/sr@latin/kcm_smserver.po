#. i18n: ectx: label, entry (confirmLogout), group (General)
#: smserversettings.kcfg:9
#, kde-format
msgid "Confirm logout"
msgstr "Potvrdi odjavljivanje"

#. i18n: ectx: label, entry (shutdownType), group (General)
#: smserversettings.kcfg:13
#, kde-format
msgid "Default leave option"
msgstr "Podrazumevana opcija napuštanja"

#. i18n: ectx: label, entry (loginMode), group (General)
#: smserversettings.kcfg:22
#, kde-format
msgid "On login"
msgstr "Po prijavljivanju"

#. i18n: ectx: label, entry (excludeApps), group (General)
#: smserversettings.kcfg:26
#, kde-format
msgid "Applications to be excluded from session"
msgstr "Programi koje treba isključiti iz sesije"

#: ui/main.qml:30
#, kde-format
msgctxt "@info:status inlinemessage"
msgid "Failed to request restart to firmware setup: %1"
msgstr ""
"Ne mogu da zatražim ponovno pokretanje u ekran za podešavanje firmvera: %1"

#: ui/main.qml:31
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"Next time the computer is restarted, it will enter UEFI firmware settings."
msgstr ""
"Pri sledećem ponovnom pokretanju računar će ući u postavke UEFI firmvera."

#: ui/main.qml:32
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"Next time the computer is restarted, it will enter the firmware setup screen."
msgstr ""
"Pri sledećem ponovnom pokretanju računar će ući u ekran za podešavanje "
"firmvera."

#: ui/main.qml:37
#, kde-format
msgctxt "@action:button"
msgid "Restart Now"
msgstr "Ponovo pokreni sada"

#: ui/main.qml:46
#, kde-format
msgctxt "@title:group"
msgid "General"
msgstr "Opšte"

#: ui/main.qml:51
#, kde-format
msgctxt ""
"@label beginning of the logical sentence 'Ask for confirmation on shutdown, "
"restart, and logout.'"
msgid "Ask for confirmation:"
msgstr "Traži potvrdu:"

#: ui/main.qml:52
#, kde-format
msgctxt ""
"@option:check end of the logical sentence 'Ask for confirmation on shutdown, "
"restart, and logout.'"
msgid "On shutdown, restart, and logout"
msgstr "Pri gašenju, ponovnom pokretanju i odjavljivanju"

#: ui/main.qml:63
#, kde-format
msgctxt "@title:group"
msgid "Session Restore"
msgstr "Obnavljanje sesije"

#: ui/main.qml:71
#, kde-format
msgctxt "@title:group prefix for radiobuttons"
msgid "On login, launch apps that were open:"
msgstr "Pri prijavljivanju pokreni programe koji su bili otvoreni:"

#: ui/main.qml:72
#, kde-format
msgctxt "@option:radio Automatic style of session restoration"
msgid "On last logout"
msgstr "Pri poslednjem odjavljivanju"

#: ui/main.qml:85
#, kde-format
msgctxt "@option:radio Manual style of session restoration"
msgid "When session was manually saved"
msgstr "Kad je sesija ručno sačuvana"

#: ui/main.qml:94
#, kde-kuit-format
msgctxt "@info"
msgid ""
"A <interface>Save Session</interface> button will appear in the "
"<interface>Application Launcher</interface> menu. When you click it, Plasma "
"will remember the apps that are open and restore them on the next login. "
"Click it again to replace the set of remembered apps."
msgstr ""
"Dugme <interface>Sačuvaj sesiju</interface> pojaviće se u meniju "
"<interface>Pokretač programa</interface>. Kad kliknete na njega, Plasma će "
"zapamtiti otvorene programe i obnoviti ih pri sledećem prijavljivanju. "
"Kliknite ponovo da zamenite skup zapamćenih programa."

#: ui/main.qml:99
#, kde-format
msgctxt ""
"@option:radio Here 'session' refers to the technical concept of session "
"restoration, whereby the windows that were open on logout are re-opened on "
"the next login"
msgid "Start with an empty session"
msgstr "Pokreni praznu sesiju"

#: ui/main.qml:113
#, kde-format
msgctxt "@label:textbox"
msgid "Ignored applications:"
msgstr "Ignorisani programi:"

#: ui/main.qml:132
#, kde-format
msgctxt "@info:whatsthis contextualhelpbutton tooltip"
msgid ""
"Write apps' desktop file identifier or, on X11, executable names here "
"(separated by commas or colons, for example 'xterm:org.kde.konsole.desktop' "
"or 'xterm,org.kde.konsole.desktop') to prevent them from autostarting along "
"with other session-restored apps."
msgstr ""
"Ovde upišite identifikatore .desktop fajlova programa ili, na prozorskom "
"sistemu X11, imena izvršnih fajlova (razdvojene zarezima ili dvotačkama, na "
"primer „xterm:org.kde.konsole.desktop“ ili „xterm,org.kde.konsole.desktop“), "
"da se ne bi automatski pokretali zajedno sa ostalim programima obnovljenim "
"iz sesije."

#: ui/main.qml:138
#, kde-format
msgctxt "@title:group"
msgid "Firmware"
msgstr "Firmver"

#: ui/main.qml:144
#, kde-format
msgctxt ""
"@label:check part of a sentence: After next restart enter UEFI/Firmware "
"setup screen"
msgid "After next restart:"
msgstr "Posle sledećeg ponovnog pokretanja:"

#: ui/main.qml:145
#, kde-format
msgctxt "@option:check"
msgid "Enter UEFI firmware settings"
msgstr "Uđi u postavke UEFI firmvera"

#: ui/main.qml:146
#, kde-format
msgctxt "@option:check"
msgid "Enter firmware setup screen"
msgstr "Uđi u ekran za podešavanje firmvera"
