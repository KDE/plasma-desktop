#: plasmasearch/ui/main.qml:45
#, kde-format
msgctxt "@info:usagetip"
msgid ""
"Enable or disable plugins (used in KRunner, Application Launcher, and the "
"Overview effect). Mark plugins as favorites and arrange them in order you "
"want to prioritize them."
msgstr ""
"Uključite ili isključite priključke (koriste ih K‑izvođač, pokretač programa "
"i efekat pregleda). Označite priključke kao omiljene i poređajte ih redom "
"kojim želite da im date prednost."

#: plasmasearch/ui/main.qml:91
#, kde-format
msgctxt "@action:button, icononly"
msgid "Remove from favorites"
msgstr "Ukloni iz omiljenih"

#: plasmasearch/ui/main.qml:91
#, kde-format
