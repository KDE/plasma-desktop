#: ui/main.qml:53
#, kde-format
msgctxt "@label:textbox"
msgid "Desktop folder:"
msgstr "Fascikla površi:"

#: ui/main.qml:59
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder contains all the files you see on your desktop."
msgstr "Ova fascikla sadrži sve fajlove koje vidite na površi."

#: ui/main.qml:67
#, kde-format
msgctxt "@label:textbox"
msgid "Documents folder:"
msgstr "Fascikla dokumenata:"

#: ui/main.qml:73
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save documents."
msgstr ""
"Ova fascikla se koristi kao podrazumevana za otvaranje ili upisivanje "
"dokumenata."

#: ui/main.qml:81
#, kde-format
msgctxt "@label:textbox"
msgid "Downloads folder:"
msgstr "Fascikla preuzimanja:"

#: ui/main.qml:87
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to save your downloaded items."
msgstr ""
"Ova fascikla se koristi kao podrazumevana za upisivanje preuzetih stavki."

#: ui/main.qml:95
#, kde-format
msgctxt "@label:textbox"
msgid "Videos folder:"
msgstr "Fascikla video snimaka:"

#: ui/main.qml:101
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save video files."
msgstr ""
"Ova fascikla se koristi kao podrazumevana za otvaranje ili upisivanje video "
"fajlova."

#: ui/main.qml:109
#, kde-format
msgctxt "@label:textbox"
msgid "Pictures folder:"
msgstr "Fascikla slika:"

#: ui/main.qml:115
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save image files."
msgstr ""
"Ova fascikla se koristi kao podrazumevana za otvaranje ili upisivanje "
"fajlova slika."

#: ui/main.qml:123
#, kde-format
msgctxt "@label:textbox"
msgid "Music folder:"
msgstr "Fascikla muzike:"

#: ui/main.qml:129
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save music files."
msgstr ""
"Ova fascikla se koristi kao podrazumevana za otvaranje ili upisivanje "
"muzičkih fajlova."

#: ui/main.qml:137
#, kde-format
msgctxt "@label:textbox"
msgid "Public folder:"
msgstr "Javna fascikla:"

#: ui/main.qml:143
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid ""
"This folder will be used by default for publicly-shared files when network "
"sharing is enabled."
msgstr ""
"Ova fascikla se koristi kao podrazumevana za javno deljene fajlove kada je "
"uključeno mrežno deljenje."

#: ui/main.qml:151
#, kde-format
msgctxt "@label:textbox"
msgid "Templates folder:"
msgstr "Fascikla šablona:"

#: ui/main.qml:157
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save file templates."
msgstr ""
"Ova fascikla se koristi kao podrazumevana za otvaranje ili upisivanje "
"šablona fajlova."

#: ui/main.qml:165
#, kde-format
msgctxt "@label:textbox"
msgid "Projects folder:"
msgstr "Fascikla projekata:"

#: ui/main.qml:171
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save projects."
msgstr ""
"Ova fascikla se koristi kao podrazumevana za otvaranje ili upisivanje "
"projekata."

