#: kcm.cpp:57
#, kde-format
msgid "Not able to select appropriate backend"
msgstr "Ne mogu da izaberem odgovarajuću pozadinu"

#: kcm.cpp:103
#, kde-format
msgid ""
"Error while loading values. See logs for more information. Please restart "
"this configuration module."
msgstr ""
"Greška pri učitavanju vrednosti. Pogledajte dnevnik za više detalja. "
"Pokrenite ponovo ovaj postavni modul."

#: kcm.cpp:106
#, kde-format
msgid "No pointer device found. Connect now."
msgstr "Nema nijednog pokazivačkog uređaja. Povežite ga sada."

#: kcm.cpp:115
#, kde-format
msgid ""
"Not able to save all changes. See logs for more information. Please restart "
"this configuration module and try again."
msgstr ""
"Ne mogu da sačuvam sve izmene. Pogledajte dnevnik za više detalja. Pokrenite "
"ponovo ovaj postavni modul pa pokušajte još opet."

#: kcm.cpp:134
#, kde-format
msgid ""
"Error while loading default values. Failed to set some options to their "
"default values."
msgstr ""
"Greška pri učitavanju podrazumevanih vrednosti. Neke od opcija ne mogu da se "
"postave na podrazumevane vrednosti."

#: kcm.cpp:149
#, kde-format
msgid ""
"Error while adding newly connected device. Please reconnect it and restart "
"this configuration module."
msgstr ""
"Greška pri dodavanju novog povezanog uređaja. Povežite ga opet i pokrenite "
"ponovo ovaj postavni modul."

#: kcm.cpp:162
#, kde-format
msgid "Pointer device disconnected. Closed its setting dialog."
msgstr "Pokazivački uređaj je otkačen. Njegov dijalog postavki je zatvoren."

#: kcm.cpp:164
#, kde-format
msgid "Pointer device disconnected. No other devices found."
msgstr "Pokazivački uređaj je otkačen. Nema drugih uređaja."

#: kwinwaylandbackend.cpp:45
#, kde-format
msgid "Critical error on reading fundamental device infos for touchpad %1."
msgstr "Kritična greška pri čitanju osnovnih podataka uređaja za dodirnik %1."

#: ui/main.qml:69
#, kde-format
msgctxt "@info:status placeholdermessage text"
msgid "No touchpad found"
msgstr "Nema nijednog dodirnika"

#: ui/main.qml:70
#, kde-format
msgctxt "@info:usagetip placeholdermessage explanation"
msgid "Connect an external touchpad"
msgstr "Povežite spoljašnji dodirnik"

#: ui/main.qml:87
#, kde-format
msgctxt "@label:listbox device selection"
msgid "Device:"
msgstr "Uređaj:"

#: ui/main.qml:110
#, kde-format
msgctxt "@title:group prefix for checkbox group"
msgid "General:"
msgstr "Opšte:"

#: ui/main.qml:111
#, kde-format
msgctxt "@option:check"
msgid "Enable device"
msgstr "Uključi uređaj"

#: ui/main.qml:126
#, kde-format
msgctxt "@option:check"
msgid "Disable while mouse is connected"
msgstr "Isključi dok je miš povezan"

#: ui/main.qml:146
#, kde-format
msgctxt "option:check"
msgid "Disable while typing"
msgstr "Isključi tokom kucanja"

#: ui/main.qml:147
#, kde-format
msgctxt "@label 'this' refers to the 'disable touchpad while typing' feature"
msgid "This can interfere with video games."
msgstr "Ovo može da smeta u video igrama."

#: ui/main.qml:169
#, kde-format
msgctxt "@title:group"
msgid "Left and right buttons:"
msgstr "Levo i desno dugme:"

#: ui/main.qml:170
#, kde-format
msgctxt "@option:check"
msgid "Swap (left-handed mode)"
msgstr "Zameni (režim za levoruke)"

#: ui/main.qml:185
#, kde-format
msgctxt "@option:check 'both' refers to the left and right buttons'"
msgid "Press both simultaneously to middle-click"
msgstr "Pritisni oba istovremeno za srednji klik"

#: ui/main.qml:197
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Activating this setting increases click latency by 50ms. The extra delay is "
"needed to correctly detect simultaneous left and right button presses."
msgstr ""
"Uključivanje ove postavke produžava kašnjenje klika za 50 ms. Dodatno "
"kašnjenje je potrebno da bi se ispravno otkrili istovremeni pritisci levog i "
"desnog dugmeta."

#: ui/main.qml:207
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Pointer speed:"
msgstr "Brzina pokazivača:"

#: ui/main.qml:287
#, kde-format
msgctxt "@option:check"
msgid "Enable pointer acceleration"
msgstr "Uključi ubrzanje pokazivača"

#: ui/main.qml:299
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"When enabled, pointer travel distance increases with faster movement speed."
msgstr "Kad je uključeno, pokazivač prelazi veći put što je pokret brži."

#: ui/main.qml:310
#, kde-format
msgctxt "@label:slider"
msgid "Scrolling speed:"
msgstr "Brzina klizanja:"

#: ui/main.qml:392
#, kde-format
msgctxt "@item:inrange Slower Scroll"
msgid "Slower"
msgstr "sporije"

#: ui/main.qml:399
#, kde-format
msgctxt "@item:inrange Faster Scroll Speed"
msgid "Faster"
msgstr "brže"

#: ui/main.qml:406
#, kde-format
msgctxt ""
"@title group begins the sentence 'Scroll by moving two fingers anywhere/"
"moving one finger on edge'"
msgid "Scroll by:"
msgstr "Klizanje:"

#: ui/main.qml:409
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'Scroll by moving two fingers anywhere'"
msgid "Moving two fingers anywhere"
msgstr "Pomeranjem dva prsta bilo gde"

#: ui/main.qml:427
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'Scroll by moving one finger on edge'"
msgid "Moving one finger on edge"
msgstr "Pomeranjem jednog prsta po ivici"

#: ui/main.qml:436
#, kde-format
msgctxt "@option:check"
msgid "Invert scroll direction (Natural scrolling)"
msgstr "Obrni smer klizanja (prirodno klizanje)"

#: ui/main.qml:453
#, kde-format
msgctxt "@option:check"
msgid "Disable horizontal scrolling"
msgstr "Isključi vodoravno klizanje"

#: ui/main.qml:471
#, kde-format
msgctxt ""
"@title:group for radiobutton group, begins the sentence 'right-click by "
"pressing bottom-right corner/pressing with two fingers'"
msgid "Right-click by:"
msgstr "Desni klik:"

#: ui/main.qml:475
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing bottom-right "
"corner'"
msgid "Pressing bottom-right corner"
msgstr "Pritiskom na donji desni ugao"

#: ui/main.qml:480
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing both bottom corners."
msgstr "Srednji klik pritiskom na oba donja ugla."

#: ui/main.qml:481
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing bottom center."
msgstr "Srednji klik pritiskom na sredinu donje ivice."

#: ui/main.qml:503
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing with two "
"fingers'"
msgid "Pressing anywhere with two fingers"
msgstr "Pritiskom dva prsta bilo gde"

#: ui/main.qml:504
#, kde-format
msgctxt "@info shown below radio button"
msgid "Middle-click by pressing anywhere with three fingers."
msgstr "Srednji klik pritiskom tri prsta bilo gde."

#: ui/main.qml:516
#, kde-format
msgctxt ""
"@label for radiobutton group, begins the sentence 'middle-click by pressing "
"bottom-middle edge/by pressing anywhere with three fingers'"
msgid "Middle-click by:"
msgstr "Srednji klik:"

#: ui/main.qml:519
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'middle-click by pressing bottom-middle "
"edge'"
msgid "Pressing bottom-middle edge"
msgstr "Pritiskom na sredinu donje ivice"

#: ui/main.qml:539
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'middle-click by pressing bottom-left "
"and bottom-right corners'"
msgid "Pressing bottom-left and bottom-right corners"
msgstr "Pritiskom na donji levi i donji desni ugao"

#: ui/main.qml:551
#, kde-format
msgctxt ""
"@option:check completes the sentence 'middle-click by pressing anywhere with "
"three fingers'"
msgid "Pressing anywhere with three fingers"
msgstr "Pritiskom tri prsta bilo gde"

#: ui/main.qml:564
#, kde-format
msgctxt "@label for checkbox, tap-to-click"
msgid "Tapping:"
msgstr "Tapkanje:"

#: ui/main.qml:565
#, kde-format
msgctxt "@option:check"
msgid "Tap to click"
msgstr "Tapni za klik"

#: ui/main.qml:580
#, kde-format
msgctxt "@option:check"
msgid "Allow dragging after tapping"
msgstr "Dozvoli prevlačenje posle tapa"

#: ui/main.qml:592
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Tap, then tap and immediately slide finger over the touchpad to drag. Lift "
"finger to drop."
msgstr ""
"Tapnite, pa ponovo tapnite i odmah povucite prst po dodirniku da biste "
"prevlačili. Podignite prst da biste spustili."

#: ui/main.qml:599
#, kde-format
msgctxt "@option:check"
msgid "Allow briefly lifting finger during tap-and-drag"
msgstr "Dozvoli kratko podizanje prsta tokom prevlačenja na tap"

#: ui/main.qml:612
#, kde-format
msgctxt "@title:group"
msgid "Two-finger tap:"
msgstr "Tap sa dva prsta:"

#: ui/main.qml:618
#, kde-format
msgctxt "@option:radio"
msgid "Right-click (three-finger tap to middle-click)"
msgstr "Desni klik (tap sa tri prsta za srednji klik)"

#: ui/main.qml:619
#, kde-format
msgctxt "@option:radio"
msgid "Right-click"
msgstr "Desni klik"

#: ui/main.qml:640
#, kde-format
msgctxt "@option:radio"
msgid "Middle-click (three-finger tap to right-click)"
msgstr "Srednji klik (tap sa tri prsta za desni klik)"

#: ui/main.qml:641
#, kde-format
msgctxt "@option:radio"
msgid "Middle-click"
msgstr "Srednji klik"
