#: kcmkded.cpp:117
#, kde-format
msgid "Failed to stop service: %1"
msgstr "Ne mogu da zaustavim servis: %1"

#: kcmkded.cpp:119
#, kde-format
msgid "Failed to start service: %1"
msgstr "Ne mogu da pokrenem servis: %1"

#: kcmkded.cpp:126
#, kde-format
msgid "Failed to stop service."
msgstr "Ne mogu da zaustavim servis."

#: kcmkded.cpp:128
#, kde-format
msgid "Failed to start service."
msgstr "Ne mogu da pokrenem servis."

#: kcmkded.cpp:226
#, kde-format
msgid "Failed to notify KDE Service Manager (kded6) of saved changed: %1"
msgstr ""
"Ne mogu da obavestim KDE menadžer servisa (kded6) o sačuvanim izmenama: %1"

#: ui/main.qml:48
#, kde-kuit-format
msgctxt "@info"
msgid ""
"If you're disabling something here to work around an issue, please <link "
"url='%1'>submit a bug report about it as well.</link>"
msgstr ""
"Ako ovde isključujete nešto da biste zaobišli neki problem, <link "
"url='%1'>prijavite i grešku zbog toga.</link>"

#: ui/main.qml:55
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"The background services manager (kded6) is currently not running. Make sure "
"it is installed correctly."
msgstr ""
"Menadžer pozadinskih servisa (kded6) trenutno nije pokrenut. Proverite da li "
"je ispravno instaliran."

#: ui/main.qml:65
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"Some services disable themselves again when manually started if they are not "
"useful in the current environment."
msgstr ""
"Neki servisi se ponovo sami isključe kad se ručno pokrenu, ako nisu korisni "
"u tekućem okruženju."

#: ui/main.qml:75
#, kde-format
msgctxt "@info:status inlinemessage"
msgid ""
"Some services were automatically started/stopped when the background "
"services manager (kded6) was restarted to apply your changes."
msgstr ""
"Neki servisi su automatski pokrenuti ili zaustavljeni kad je menadžer "
"pozadinskih servisa (kded6) ponovo pokrenut radi primene vaših izmena."

