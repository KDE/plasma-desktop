#: ui/main.qml:44
#, kde-format
msgctxt "@action:button"
msgid "Pause Indexer"
msgstr "Pauziraj indeksar"

#: ui/main.qml:44
#, kde-format
msgctxt "@action:button"
msgid "Resume Indexer"
msgstr "Nastavi rad indeksara"

#: ui/main.qml:61
#, kde-format
msgctxt "@info inlinemessage"
msgid ""
"This will disable file searching in KRunner and launcher menus, and remove "
"extended metadata display from all KDE applications."
msgstr ""
"Ovo će isključiti pretragu fajlova u K‑izvođaču i menijima pokretača, i "
"ukloniti prikaz proširenih metapodataka iz svih KDE programa."

#: ui/main.qml:71
#, kde-format
msgctxt "@info:inlinemessage"
msgid ""
"Do you want to delete the saved index data? %1 of space will be freed, but "
"if indexing is re-enabled later, the entire index will have to be re-created "
"from scratch. This may take some time, depending on the number of files to "
"index."
msgstr ""
"Želite li da obrišete sačuvane podatke indeksa? Oslobodiće se %1 prostora na "
"disku, ali ako se indeksiranje kasnije ponovo uključi, ceo indeks će morati "
"da se napravi iznova. To može potrajati, zavisno od broja fajlova za "
"indeksiranje."

#: ui/main.qml:73
#, kde-format
msgctxt "@action:button"
msgid "Delete Index Data"
msgstr "Obriši podatke indeksa"

#: ui/main.qml:83
#, kde-format
msgctxt "@info:usagetip"
msgid ""
"File Search helps you quickly locate your files. You can choose which "
"folders and what types of file data are indexed."
msgstr ""
"Pretraga fajlova vam pomaže da brzo nađete svoje fajlove. Možete izabrati "
"koje se fascikle i koje vrste podataka o fajlovima indeksiraju."

#: ui/main.qml:102
#, kde-format
msgctxt "@title:group"
msgid "Data to index:"
msgstr "Podaci za indeksiranje:"

#: ui/main.qml:106
#, kde-format
msgctxt "@option:radio Data to index"
msgid "Nothing (disable indexing entirely)"
msgstr "Ništa (potpuno isključi indeksiranje)"

#: ui/main.qml:124
#, kde-format
msgctxt "@option:radio Data to index"
msgid "File names only"
msgstr "Samo imena fajlova"

#: ui/main.qml:142
#, kde-format
msgctxt "@option:radio Data to index"
msgid "File names and contents"
msgstr "Imena fajlova i sadržaj"

#: ui/main.qml:162
#, kde-format
msgctxt "@option:check"
msgid "Also index hidden files and folders"
msgstr "Indeksiraj i skrivene fajlove i fascikle"

#: ui/main.qml:189
#, kde-format
msgctxt "@title:table Locations to include or exclude from indexing"
msgid "Locations"
msgstr "Lokacije"

#: ui/main.qml:192
#, kde-format
msgctxt "@action:button"
msgid "Start Indexing a Folder…"
msgstr "Počni indeksiranje fascikle…"

#: ui/main.qml:200
#, kde-format
msgctxt "@action:button"
msgid "Stop Indexing a Folder…"
msgstr "Zaustavi indeksiranje fascikle…"

#: ui/main.qml:218
#, kde-format
msgctxt "State and a percentage of progress"
msgid "%1, %2% complete"
msgstr "%1, %2% dovršeno"

#: ui/main.qml:225
#, kde-kuit-format
msgctxt "@info Currently Indexing"
msgid "Currently indexing: <filename>%1</filename>"
msgstr "Trenutno indeksiram: <filename>%1</filename>"

#: ui/main.qml:276
#, kde-format
msgctxt "@info:status"
msgid "Not indexed"
msgstr "Nije indeksirano"

#: ui/main.qml:277
#, kde-format
msgctxt "@info:status"
msgid "Indexed"
msgstr "Indeksirano"

#: ui/main.qml:303
#, kde-format
msgctxt "Remove the list item for this filesystem path"
msgid "Remove entry"
msgstr "Ukloni stavku"

#: ui/main.qml:324
#, kde-format
msgctxt "@title:window"
msgid "Select a folder to include"
msgstr "Izbor fascikle za uključivanje"

#: ui/main.qml:324
#, kde-format
msgctxt "@title:window"
msgid "Select a folder to exclude"
msgstr "Izbor fascikle za isključivanje"
