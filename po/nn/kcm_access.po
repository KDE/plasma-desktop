msgid "Enable"
msgstr "Slå på"

#: ui/MouseNavigation.qml:31
#, kde-kuit-format
msgctxt "@info:tooltip"
msgid ""
"The numpad key <shortcut>5</shortcut> functions as a mouse click, toggled by "
"<shortcut>/</shortcut> for middle click, <shortcut>*</shortcut> for right "
"click and <shortcut>NumLock</shortcut> for left click. The keys <shortcut>2</"
"shortcut>, <shortcut>4</shortcut>, <shortcut>6</shortcut>, and <shortcut>8</"
"shortcut> allow for cardinal movement (down, left, right, and up). The keys "
"<shortcut>1</shortcut>, <shortcut>3</shortcut>, <shortcut>7</shortcut>, and "
"<shortcut>9</shortcut> allow for diagonal movement."
msgstr ""
"Bruk tasten <shortcut>5</shortcut> på tal­tastaturet for å gjera eit muse­"
"klikk. Hald inne <shortcut>/</shortcut> for midt­klikk, <shortcut>*</"
"shortcut> for høgre­klikk og <shortcut>Num Lock</shortcut> for venstre­klikk. "
"Bruk tastane <shortcut>2</shortcut>, <shortcut>4</shortcut>, <shortcut>6</"
"shortcut> og <shortcut>8</shortcut> for å flytta peikaren høvesvis ned, til "
"venstre, til høgre og opp. Bruk tastane <shortcut>1</shortcut>, <shortcut>3</"
"shortcut>, <shortcut>7</shortcut> og <shortcut>9</shortcut> for å flytta "
"peikaren på skrå."

#: ui/MouseNavigation.qml:37
#, kde-format
msgctxt "@label:spinbox"
