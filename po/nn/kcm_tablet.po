msgid "Calibration Not Supported"
msgstr "Kalibrering er ikkje støtta"

#: ui/StylusTab.qml:516
#, kde-format
msgctxt "@action:button"
msgid "Reset Custom Calibration"
msgstr "Nullstill tilpassa kalibrering"

