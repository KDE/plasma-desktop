#: ui/StylusTab.qml:516
#, kde-format
msgctxt "@action:button"
msgid "Reset Custom Calibration"
msgstr "Palauta kalibroinnin mukautus"

#: ui/Tester.qml:25
#, kde-format
msgctxt "@title"
msgid "Tablet Tester"
msgstr "Piirtoalustan kokeilu"

#: ui/Tester.qml:48
#, kde-format
msgctxt ""
"A tablet stylus was pressed onto the surface X=[x position] Y=[y position]"
msgid "Stylus press X=%1 Y=%2"
msgstr "Kynän painallus X=%1 Y=%2"

#: ui/Tester.qml:58
#, kde-format
msgctxt ""
"A tablet stylus has 'released' or was lifted from the surface X=[x position] "
"Y=[y position]"
msgid "Stylus release X=%1 Y=%2"
msgstr "Kynän vapautus X=%1 Y=%2"

#: ui/Tester.qml:68
#, kde-format
msgctxt ""
"A tablet stylus has moved over the surface X=[x position] Y=[y position] "
"P=[pressure] TX=[tilt x] TY=[tilt y]"
msgid "Stylus move X=%1 Y=%2 P=%3% TX=%4 TY=%5"
msgstr "Kynän liike X=%1 Y=%2 P=%3 % TX=%4 TY=%5"

#: ui/Tester.qml:75
#, kde-format
msgctxt "A tablet pad's button has been pressed B=[the button number]"
msgid "Pad button press B=%1"
msgstr "Alustan painikkeen painallus B=%1"

#: ui/Tester.qml:77
#, kde-format
msgctxt "A tablet pad's button has been released B=[the button number]"
msgid "Pad button release B=%1"
msgstr "Alustan painikkeen vapautus B=%1"

#: ui/Tester.qml:83
#, kde-format
msgctxt ""
"A tablet pad's dial has moved, V120 here refers to 'Value 120' which is a "
"technical term that should be kept as is"
msgid "Pad dial moved V120=%1"
msgstr "Alustan valintakiekko liikkui V120=%1"

#: ui/Tester.qml:219
#, kde-format
msgctxt "The tablet tester legend which is shown on start-up"
msgid ""
"## Legend:\n"
"# X, Y - event coordinate\n"
"# P - pressure\n"
"# TX,TY - tilt\n"
msgstr ""
"## Selite:\n"
"# X, Y - tapahtumakoordinaatti\n"
"# P – paine\n"
"# TX, TY – kallistus\n"

#: ui/Tester.qml:225
#, kde-format
