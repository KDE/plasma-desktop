#: ui/main.qml:53
#, kde-format
msgctxt "@label:textbox"
msgid "Desktop folder:"
msgstr "Toh-bīn tsu-liāu-giap-á:"

#: ui/main.qml:59
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder contains all the files you see on your desktop."
msgstr ""
"Tsit ê tsu-liāu-giap-á iōng-lâi khǹg ē tī toh-bīn khuànn tio̍h ê tòng-àn."

#: ui/main.qml:67
#, kde-format
msgctxt "@label:textbox"
msgid "Documents folder:"
msgstr "Bûn-kiānn tsu-liāu-giap-á:"

#: ui/main.qml:73
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save documents."
msgstr ""
"Tsit ê tsu-liāu-giap-á ē iōng tsò phah-khui á-sī tû-tsûn bûn-kiānn ê ū-siat "
"uī-tì."

#: ui/main.qml:81
#, kde-format
msgctxt "@label:textbox"
msgid "Downloads folder:"
msgstr "Hā-tsài tsu-liāu-giap-á:"

#: ui/main.qml:87
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to save your downloaded items."
msgstr ""
"Tsit ê tsu-liāu-giap-á ē iōng tsò hā-tsài mi̍h-kiānn ê sî-tsūn ê ū-siat uī-tì."

#: ui/main.qml:95
#, kde-format
msgctxt "@label:textbox"
msgid "Videos folder:"
msgstr "Iánn-phìnn tsu-liāu-giap-á:"

#: ui/main.qml:101
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save video files."
msgstr ""
"Tsit ê tsu-liāu-giap-á ē iōng tsò phah-khui á-sī tû-tsûn iánn-phìnn tóng-àn "
"ê ū-siat uī-tì."

#: ui/main.qml:109
#, kde-format
msgctxt "@label:textbox"
msgid "Pictures folder:"
msgstr "Tôo-phìnn tsu-liāu-giap-á:"

#: ui/main.qml:115
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save image files."
msgstr ""
"Tsit ê tsu-liāu-giap-á ē iōng tsò phah-khui á-sī tû-tsûn tôo-phìnn tóng-àn ê "
"ū-siat uī-tì."

#: ui/main.qml:123
#, kde-format
msgctxt "@label:textbox"
msgid "Music folder:"
msgstr "Im-ga̍k tsu-liāu-giap-á:"

#: ui/main.qml:129
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save music files."
msgstr ""
"Tsit ê tsu-liāu-giap-á ē iōng tsò phah-khui á-sī tû-tsûn im-ga̍k tóng-àn ê ū-"
"siat uī-tì."

#: ui/main.qml:137
#, kde-format
msgctxt "@label:textbox"
msgid "Public folder:"
msgstr "Kong-khai tsu-liāu-giap-á:"

#: ui/main.qml:143
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid ""
"This folder will be used by default for publicly-shared files when network "
"sharing is enabled."
msgstr ""
"Tsit ê tsu-liāu-giap-á ē tī khé-iōng  bāng-lōo hun-hiáng ê sî-tsūn iōng tsò "
"kong-khai hun-hiáng ê tóng-àn ê ū-siat uī-tì."

#: ui/main.qml:151
#, kde-format
msgctxt "@label:textbox"
msgid "Templates folder:"
msgstr "Pang-bôo tsu-liāu-giap-á:"

#: ui/main.qml:157
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save file templates."
msgstr ""
"Tsit ê tsu-liāu-giap-á ē iōng tsò phah-khui á-sī tû-tsûn tóng-àn pang-bôo ê "
"ū-siat uī-tì."

#: ui/main.qml:165
#, kde-format
msgctxt "@label:textbox"
msgid "Projects folder:"
msgstr "Tsuan-àn tsu-liāu-giap-á:"

#: ui/main.qml:171
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save projects."
msgstr ""
"Tsit ê tsu-liāu-giap-á ē iōng tsò phah-khui á-sī tû-tsûn tsuan-àn ê ū-siat "
"uī-tì."

#: ui/UrlRequester.qml:74
#, kde-format
msgctxt "@action:button"
msgid "Choose new location"
msgstr "Suán sin ê uī-tì"
