#: kcm.cpp:57
#, kde-format
msgid "Not able to select appropriate backend"
msgstr "Bô-huat-tōo suán sik-ha̍p ê āu-tuan"

#: kcm.cpp:103
#, kde-format
msgid ""
"Error while loading values. See logs for more information. Please restart "
"this configuration module."
msgstr ""
"Tsài-ji̍p siat-tīng-ti̍t ê sî-tsūn ū tshò-gōo. Siông-sè tshiánn khuànn kì-lo̍k. "
"Tshiánn kā tsit ê siat-tīng bôo-tsoo tîng-khé-tōng."

#: kcm.cpp:106
#, kde-format
msgid "No pointer device found. Connect now."
msgstr "Tshuē bô tsí-piau tsong-tì. Tshiánn kā i liân-tsiap."

#: kcm.cpp:115
#, kde-format
msgid ""
"Not able to save all changes. See logs for more information. Please restart "
"this configuration module and try again."
msgstr ""
"Bô-huat-tōo tû-tsûn sóo-ū ê piàn-king. Siông-sè tshiánn khuànn kì-lo̍k. "
"Tshiánn kā tsit ê siat-tīng bôo-tsoo tîng-khé-tōng, jiân-āu koh tshì tsi̍t-"
"pái."

#: kcm.cpp:134
#, kde-format
msgid ""
"Error while loading default values. Failed to set some options to their "
"default values."
msgstr ""

#: kcm.cpp:149
#, kde-format
msgid ""
"Error while adding newly connected device. Please reconnect it and restart "
"this configuration module."
msgstr ""

#: kcm.cpp:162
#, kde-format
msgid "Pointer device disconnected. Closed its setting dialog."
msgstr ""

#: kcm.cpp:164
#, kde-format
msgid "Pointer device disconnected. No other devices found."
msgstr ""

#: kwinwaylandbackend.cpp:45
#, kde-format
msgid "Critical error on reading fundamental device infos for touchpad %1."
msgstr ""

#: ui/main.qml:69
#, kde-format
msgctxt "@info:status placeholdermessage text"
msgid "No touchpad found"
msgstr "Tshuē bô tshiok-khòng-pán"

#: ui/main.qml:70
#, kde-format
msgctxt "@info:usagetip placeholdermessage explanation"
msgid "Connect an external touchpad"
msgstr "Tshiánn liân-tsiap guā-pōo tshiok-khòng-pán"

#: ui/main.qml:87
#, kde-format
msgctxt "@label:listbox device selection"
msgid "Device:"
msgstr "Tsong-tì:"

#: ui/main.qml:110
#, kde-format
msgctxt "@title:group prefix for checkbox group"
msgid "General:"
msgstr "It-puann:"

#: ui/main.qml:111
#, kde-format
msgctxt "@option:check"
msgid "Enable device"
msgstr "Khé-iōng tsong-tì"

#: ui/main.qml:126
#, kde-format
msgctxt "@option:check"
msgid "Disable while mouse is connected"
msgstr "Ū liân-tsiap ku̍t-tshí ê sî-tsūn thîng-iōng"

#: ui/main.qml:144
#, kde-format
msgctxt "option:check"
msgid "Disable while typing"
msgstr "Phah-jī ê sî-tsūn thîng-iōng"

#: ui/main.qml:145
#, kde-format
msgctxt "@label 'this' refers to the 'disable touchpad while typing' feature"
msgid "This can interfere with video games."
msgstr "Tse khó-lîng ē hông-gāi iû-hì."

#: ui/main.qml:165
#, kde-format
msgctxt "@title:group"
msgid "Left and right buttons:"
msgstr "Tó-khí kap tsiànn-khí:"

#: ui/main.qml:166
#, kde-format
msgctxt "@option:check"
msgid "Swap (left-handed mode)"
msgstr ""

#: ui/main.qml:184
#, kde-format
msgctxt "@option:check 'both' refers to the left and right buttons'"
msgid "Press both simultaneously to middle-click"
msgstr "Nn̄g-pîng tsò-hué tshi̍h lâi tsò tiong-khí tiám-tshi̍h"

#: ui/main.qml:197
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Activating this setting increases click latency by 50ms. The extra delay is "
"needed to correctly detect simultaneous left and right button presses."
msgstr ""

#: ui/main.qml:198
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"This setting is not available while “Right-click by pressing anywhere with "
"two fingers” is selected."
msgstr ""

#: ui/main.qml:208
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Pointer speed:"
msgstr "Tsí-piau sok-tōo:"

#: ui/main.qml:288
#, kde-format
msgctxt "@option:check"
msgid "Enable pointer acceleration"
msgstr "Khé-iōng tsí-piau ka-sok"

#: ui/main.qml:300
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"When enabled, pointer travel distance increases with faster movement speed."
msgstr "Khé-iōng ê sî-tsūn, tshiú î-tōng jú kín tsí-piau tio̍h ē î-tōng jú hn̄g."

#: ui/main.qml:311
#, kde-format
msgctxt "@label:slider"
msgid "Scrolling speed:"
msgstr "Kńg-tōng sok-tōo:"

#: ui/main.qml:393
#, kde-format
msgctxt "@item:inrange Slower Scroll"
msgid "Slower"
msgstr "Khah-bān"

#: ui/main.qml:400
#, kde-format
msgctxt "@item:inrange Faster Scroll Speed"
msgid "Faster"
msgstr "Khah-kín"

#: ui/main.qml:407
#, kde-format
msgctxt ""
"@title group begins the sentence 'Scroll by moving two fingers anywhere/"
"moving one finger on edge'"
msgid "Scroll by:"
msgstr "Kńg-tōng hong-huat:"

#: ui/main.qml:410
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'Scroll by moving two fingers anywhere'"
msgid "Moving two fingers anywhere"
msgstr "Suá nn̄g-ê tshiú-tsí"

#: ui/main.qml:428
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'Scroll by moving one finger on edge'"
msgid "Moving one finger on edge"
msgstr "Tī pinn--á suá tsi̍t-ê tshiú-tsí"

#: ui/main.qml:437
#, kde-format
msgctxt "@option:check"
msgid "Invert scroll direction (Natural scrolling)"
msgstr "Hōo kńg-tōng hong-hiòng tian-tò (Tsū-jiân Kńg-tōng)"

#: ui/main.qml:454
#, kde-format
msgctxt "@option:check"
msgid "Disable horizontal scrolling"
msgstr "Kā tsuí-pîng kńg-tōng thîng-iōng"

#: ui/main.qml:472
#, kde-format
msgctxt ""
"@title:group for radiobutton group, begins the sentence 'right-click by "
"pressing bottom-right corner/pressing with two fingers'"
msgid "Right-click by:"
msgstr "Tsiànn-khí tiám-tshi̍h hong-huat:"

#: ui/main.qml:478
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing bottom-left "
"corner'"
msgid "Pressing bottom-left corner"
msgstr "Tshi̍h ē-kha tò-pîng ê kak-thâu"

#: ui/main.qml:479
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing bottom-right "
"corner'"
msgid "Pressing bottom-right corner"
msgstr "Tshi̍h ē-kha tsiànn-pîng ê kak-thâu"

#: ui/main.qml:485
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing both bottom corners."
msgstr ""
"Tsò-hué tshi̍h ē-kha nn̄g-pîng ê kak-thâu lâi tsò tiong-khí ê tiám-tshi̍h."

#: ui/main.qml:486
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing bottom center."
msgstr "Tshi̍h ē-kha ê tiong-ng lâi tsò tiong-khí ê tiám-tshi̍h."

#: ui/main.qml:508
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing with two "
"fingers'"
msgid "Pressing anywhere with two fingers"
msgstr "Nn̄g ê tshiú-tsí tsò-hué tshi̍h jīm-hô sóo-tsāi"

#: ui/main.qml:509
#, kde-format
msgctxt "@info shown below radio button"
msgid "Middle-click by pressing anywhere with three fingers."
msgstr ""
"Iōng sann ê tshiú-tsí tsò-hué tshi̍h jīm-hô sóo-tsāi lâi tsò tiong-khí tiám-"
"tshi̍h."

#: ui/main.qml:526
#, kde-format
msgctxt "@label for checkbox, tap-to-click"
msgid "Tapping:"
msgstr "Tiám tshiok-khòng-pán:"

#: ui/main.qml:527
#, kde-format
msgctxt "@option:check"
msgid "Tap to click"
msgstr "Tiám tshiok-khòng-pán lâi tiám-tshi̍h"

#: ui/main.qml:542
#, kde-format
msgctxt "@option:check"
msgid "Allow dragging after tapping"
msgstr "Ún-tsún tiám--ah liáu-āu ē-sái koh kè-sio̍k thua"

#: ui/main.qml:554
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Tap, then tap and immediately slide finger over the touchpad to drag. Lift "
"finger to drop."
msgstr ""
"Tiám tsi̍t-pái jiân-āu koh má-siōng tiám tsi̍t-pái, tē-jī pái ê sî-tsūn khai-"
"sí suá tshiú-tsí lâi thua-tōng. Kā tshiú-tsí thê--khí-lâi lâi kā leh thua ê "
"mi̍h-kiānn pàng--leh."

#: ui/main.qml:561
#, kde-format
msgctxt "@option:check"
msgid "Allow briefly lifting finger during tap-and-drag"
msgstr ""
"Ún-tsún tī tiám-koh-thua ê sî-tsūn hōo tshiú-tsí ū tsi̍t-sut-á sî-kan thê--"
"khí-lâi"

#: ui/main.qml:574
#, kde-format
msgctxt "@title:group"
msgid "Two-finger tap:"
msgstr "Nn̄g-tsí tiám:"

#: ui/main.qml:579
#, kde-format
msgctxt "@option:radio"
msgid "Right-click"
msgstr "Tsiànn-khí tiám-tshi̍h"

#: ui/main.qml:582
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by tapping anywhere with three fingers."
msgstr ""
"Iōng sann ê tshiú-tsí tsò-hué tiám jīm-hô sóo-tsāi lâi tsò tiong-khí tiám-"
"tshi̍h."

#: ui/main.qml:604
#, kde-format
msgctxt "@option:radio"
msgid "Middle-click"
msgstr "Tiong-khí tiám-tshi̍h"

#: ui/main.qml:607
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Right-click by tapping anywhere with three fingers."
msgstr ""
"Iōng sann ê tshiú-tsí tsò-hué tiám jīm-hô sóo-tsāi lâi tsò tsiànn-khí tiám-"
"tshi̍h."
