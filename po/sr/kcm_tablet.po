"## Legend:\n"
"# X, Y - event coordinate\n"
"# P - pressure\n"
"# TX,TY - tilt\n"
msgstr ""
"## Легенда:\n"
"# X, Y - координата догађаја\n"
"# P - притисак\n"
"# TX,TY - нагиб\n"

