#: ui/StylusTab.qml:241
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Tells the device to accommodate left-handed users. Effects will vary by "
"device, but often it reverses the pad buttonsʼ functionality so the tablet "
"can be used upside-down."
msgstr ""
"Прилагођава уређај леворуким корисницима. Дејство зависи од уређаја, али "
"обично се обрћу улоге дугмади подлоге, тако да таблица може да се користи "
"наопако."

#: ui/StylusTab.qml:247
#, kde-format
msgctxt ""
"'Mode' is the mode the stylus is in, pen (absolute) or mouse (relative)"
msgid "Mode:"
msgstr "Режим:"

#: ui/StylusTab.qml:251
#, kde-format
msgctxt ""
"@option:radio Pen mode, where the point on the screen is always where you "
"touch the stylus"
msgid "Pen"
msgstr "Оловка"

# switch-rule: t-cursor > t-pointer
#: ui/StylusTab.qml:256
#, kde-format
msgctxt "@info:whatsthis Accessible description"
msgid "The cursor follows where you touch the pen on the surface"
msgstr "Показивач прати место где оловком додирнете површину"

#: ui/StylusTab.qml:265
#, kde-format
msgctxt ""
"@option:radio Mouse mode, or like using the tablet like a giant touchpad"
