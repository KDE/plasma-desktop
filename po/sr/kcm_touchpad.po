#: kcm.cpp:57
#, kde-format
msgid "Not able to select appropriate backend"
msgstr "Не могу да изаберем одговарајућу позадину"

#: kcm.cpp:103
#, kde-format
msgid ""
"Error while loading values. See logs for more information. Please restart "
"this configuration module."
msgstr ""
"Грешка при учитавању вредности. Погледајте дневник за више детаља. Покрените "
"поново овај поставни модул."

#: kcm.cpp:106
#, kde-format
msgid "No pointer device found. Connect now."
msgstr "Нема ниједног показивачког уређаја. Повежите га сада."

#: kcm.cpp:115
#, kde-format
msgid ""
"Not able to save all changes. See logs for more information. Please restart "
"this configuration module and try again."
msgstr ""
"Не могу да сачувам све измене. Погледајте дневник за више детаља. Покрените "
"поново овај поставни модул па покушајте још опет."

#: kcm.cpp:134
#, kde-format
msgid ""
"Error while loading default values. Failed to set some options to their "
"default values."
msgstr ""
"Грешка при учитавању подразумеваних вредности. Неке од опција не могу да се "
"поставе на подразумеване вредности."

#: kcm.cpp:149
#, kde-format
msgid ""
"Error while adding newly connected device. Please reconnect it and restart "
"this configuration module."
msgstr ""
"Грешка при додавању новог повезаног уређаја. Повежите га опет и покрените "
"поново овај поставни модул."

#: kcm.cpp:162
#, kde-format
msgid "Pointer device disconnected. Closed its setting dialog."
msgstr "Показивачки уређај је откачен. Његов дијалог поставки је затворен."

#: kcm.cpp:164
#, kde-format
msgid "Pointer device disconnected. No other devices found."
msgstr "Показивачки уређај је откачен. Нема других уређаја."

#: kwinwaylandbackend.cpp:45
#, kde-format
msgid "Critical error on reading fundamental device infos for touchpad %1."
msgstr "Критична грешка при читању основних података уређаја за додирник %1."

#: ui/main.qml:69
#, kde-format
msgctxt "@info:status placeholdermessage text"
msgid "No touchpad found"
msgstr "Нема ниједног додирника"

#: ui/main.qml:70
#, kde-format
msgctxt "@info:usagetip placeholdermessage explanation"
msgid "Connect an external touchpad"
msgstr "Повежите спољашњи додирник"

#: ui/main.qml:87
#, kde-format
msgctxt "@label:listbox device selection"
msgid "Device:"
msgstr "Уређај:"

#: ui/main.qml:110
#, kde-format
msgctxt "@title:group prefix for checkbox group"
msgid "General:"
msgstr "Опште:"

#: ui/main.qml:111
#, kde-format
msgctxt "@option:check"
msgid "Enable device"
msgstr "Укључи уређај"

#: ui/main.qml:126
#, kde-format
msgctxt "@option:check"
msgid "Disable while mouse is connected"
msgstr "Искључи док је миш повезан"

#: ui/main.qml:146
#, kde-format
msgctxt "option:check"
msgid "Disable while typing"
msgstr "Искључи током куцања"

#: ui/main.qml:147
#, kde-format
msgctxt "@label 'this' refers to the 'disable touchpad while typing' feature"
msgid "This can interfere with video games."
msgstr "Ово може да смета у видео играма."

#: ui/main.qml:169
#, kde-format
msgctxt "@title:group"
msgid "Left and right buttons:"
msgstr "Лево и десно дугме:"

#: ui/main.qml:170
#, kde-format
msgctxt "@option:check"
msgid "Swap (left-handed mode)"
msgstr "Замени (режим за леворуке)"

#: ui/main.qml:188
#, kde-format
msgctxt "@option:check 'both' refers to the left and right buttons'"
msgid "Press both simultaneously to middle-click"
msgstr "Притисни оба истовремено за средњи клик"

#: ui/main.qml:201
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Activating this setting increases click latency by 50ms. The extra delay is "
"needed to correctly detect simultaneous left and right button presses."
msgstr ""
"Укључивање ове поставке продужава кашњење клика за 50 ms. Додатно кашњење је "
"потребно да би се исправно открили истовремени притисци левог и десног "
"дугмета."

#: ui/main.qml:202
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"This setting is not available while “Right-click by pressing anywhere with "
"two fingers” is selected."
msgstr ""
"Ова поставка није доступна док је изабрано „Десни клик притиском два прста "
"било где“."

#: ui/main.qml:212
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Pointer speed:"
msgstr "Брзина показивача:"

#: ui/main.qml:292
#, kde-format
msgctxt "@option:check"
msgid "Enable pointer acceleration"
msgstr "Укључи убрзање показивача"

#: ui/main.qml:304
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"When enabled, pointer travel distance increases with faster movement speed."
msgstr "Кад је укључено, показивач прелази већи пут што је покрет бржи."

#: ui/main.qml:315
#, kde-format
msgctxt "@label:slider"
msgid "Scrolling speed:"
msgstr "Брзина клизања:"

#: ui/main.qml:397
#, kde-format
msgctxt "@item:inrange Slower Scroll"
msgid "Slower"
msgstr "спорије"

#: ui/main.qml:404
#, kde-format
msgctxt "@item:inrange Faster Scroll Speed"
msgid "Faster"
msgstr "брже"

#: ui/main.qml:411
#, kde-format
msgctxt ""
"@title group begins the sentence 'Scroll by moving two fingers anywhere/"
"moving one finger on edge'"
msgid "Scroll by:"
msgstr "Клизање:"

#: ui/main.qml:414
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'Scroll by moving two fingers anywhere'"
msgid "Moving two fingers anywhere"
msgstr "Померањем два прста било где"

#: ui/main.qml:432
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'Scroll by moving one finger on edge'"
msgid "Moving one finger on edge"
msgstr "Померањем једног прста по ивици"

#: ui/main.qml:441
#, kde-format
msgctxt "@option:check"
msgid "Invert scroll direction (Natural scrolling)"
msgstr "Обрни смер клизања (природно клизање)"

#: ui/main.qml:458
#, kde-format
msgctxt "@option:check"
msgid "Disable horizontal scrolling"
msgstr "Искључи водоравно клизање"

#: ui/main.qml:476
#, kde-format
msgctxt ""
"@title:group for radiobutton group, begins the sentence 'right-click by "
"pressing bottom-right corner/pressing with two fingers'"
msgid "Right-click by:"
msgstr "Десни клик:"

#: ui/main.qml:482
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing bottom-left "
"corner'"
msgid "Pressing bottom-left corner"
msgstr "Притиском на доњи леви угао"

#: ui/main.qml:483
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing bottom-right "
"corner'"
msgid "Pressing bottom-right corner"
msgstr "Притиском на доњи десни угао"

#: ui/main.qml:489
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing both bottom corners."
msgstr "Средњи клик притиском на оба доња угла."

#: ui/main.qml:490
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing bottom center."
msgstr "Средњи клик притиском на средину доње ивице."

#: ui/main.qml:512
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing with two "
"fingers'"
msgid "Pressing anywhere with two fingers"
msgstr "Притиском два прста било где"

#: ui/main.qml:513
#, kde-format
msgctxt "@info shown below radio button"
msgid "Middle-click by pressing anywhere with three fingers."
msgstr "Средњи клик притиском три прста било где."

#: ui/main.qml:530
#, kde-format
msgctxt "@label for checkbox, tap-to-click"
msgid "Tapping:"
msgstr "Тапкање:"

#: ui/main.qml:531
#, kde-format
msgctxt "@option:check"
msgid "Tap to click"
msgstr "Тапни за клик"

#: ui/main.qml:546
#, kde-format
msgctxt "@option:check"
msgid "Allow dragging after tapping"
msgstr "Дозволи превлачење после тапа"

#: ui/main.qml:558
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Tap, then tap and immediately slide finger over the touchpad to drag. Lift "
"finger to drop."
msgstr ""
"Тапните, па поново тапните и одмах повуците прст по додирнику да бисте "
"превлачили. Подигните прст да бисте спустили."

#: ui/main.qml:565
#, kde-format
msgctxt "@option:check"
msgid "Allow briefly lifting finger during tap-and-drag"
msgstr "Дозволи кратко подизање прста током превлачења на тап"

#: ui/main.qml:578
#, kde-format
msgctxt "@title:group"
msgid "Two-finger tap:"
msgstr "Тап са два прста:"

#: ui/main.qml:583
#, kde-format
msgctxt "@option:radio"
msgid "Right-click"
msgstr "Десни клик"

#: ui/main.qml:586
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by tapping anywhere with three fingers."
msgstr "Средњи клик тапом са три прста било где."

#: ui/main.qml:608
#, kde-format
msgctxt "@option:radio"
msgid "Middle-click"
msgstr "Средњи клик"

#: ui/main.qml:611
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Right-click by tapping anywhere with three fingers."
msgstr "Десни клик тапом са три прста било где."
