#: ui/StylusTab.qml:228
#, kde-format
msgctxt "@label prefix for checkbox"
msgid "Left-handed mode:"
msgstr "Način za levičarje:"

#: ui/StylusTab.qml:231
#, kde-format
msgctxt "@option:check Enable left-handed mode"
msgid "Enable"
msgstr "Omogoči"

#: ui/StylusTab.qml:241
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Tells the device to accommodate left-handed users. Effects will vary by "
"device, but often it reverses the pad buttonsʼ functionality so the tablet "
"can be used upside-down."
msgstr ""
"Napravi pove, naj se prilagodi levičarjem. Učinki se bodo razlikovali glede "
"na napravo, vendar pogosto obrnejo delovanje gumbov ploščice, tako da je "
"tablico mogoče uporabljati obrnjeno na glavo."

#: ui/StylusTab.qml:247
#, kde-format
msgctxt ""
"'Mode' is the mode the stylus is in, pen (absolute) or mouse (relative)"
msgid "Mode:"
msgstr "Način:"

#: ui/StylusTab.qml:251
#, kde-format
msgctxt ""
"@option:radio Pen mode, where the point on the screen is always where you "
"touch the stylus"
msgid "Pen"
msgstr "Pisalo"

#: ui/StylusTab.qml:256
#, kde-format
msgctxt "@info:whatsthis Accessible description"
msgid "The cursor follows where you touch the pen on the surface"
msgstr "Kazalec sledi mestu, kjer se dotaknete peresa na površini"

#: ui/StylusTab.qml:265
#, kde-format
msgctxt ""
"@option:radio Mouse mode, or like using the tablet like a giant touchpad"
msgid "Mouse"
msgstr "Miška"

#: ui/StylusTab.qml:270
#, kde-format
msgctxt "@info:whatsthis Accessible description"
msgid ""
"Moving the pen on the surface moves the cursor relative to where it was, "
"like a mouse"
msgstr ""
"S premikanjem peresa po površini se kazalec premakne glede na to, kje je "
"bil, podobno kot miška"

#: ui/StylusTab.qml:276
#, kde-format
msgid "Sync with mouse cursor"
msgstr "Sinhroniziraj s kazalcem miške"

#: ui/StylusTab.qml:345
#, kde-format
msgctxt "@label prefix for pen pressure curve config"
msgid "Pen Pressure:"
msgstr "Pritisk pisala:"

#: ui/StylusTab.qml:401
#, kde-format
msgctxt "% of minimum pen pressure"
msgid "%1%"
msgstr "%1%"

#: ui/StylusTab.qml:409
#, kde-format
msgctxt "% of maximum pen pressure"
msgid "%1%"
msgstr "%1%"

#: ui/StylusTab.qml:420
#, kde-format
msgctxt "100% or maximum pen pressure"
msgid "100%"
msgstr "100%"

#: ui/StylusTab.qml:428
#, kde-format
msgctxt "0% or zero pen pressure"
msgid "0%"
msgstr "0%"

#: ui/StylusTab.qml:433
#, kde-format
msgctxt "@info"
msgid ""
"This curve controls the relationship between the pressure on the stylus and "
"the pressure values received by applications."
msgstr ""
"Ta krivulja nadzira razmerje med pritiskom na pisalo in vrednostmi pritiska, "
"ki jih prejmejo aplikacije."

#: ui/StylusTab.qml:438
#, kde-format
msgctxt "Pen pressure range"
msgid "Pressure Range:"
msgstr "Razpon pritiska:"

#: ui/StylusTab.qml:456
#, kde-format
msgctxt "@info"
msgid ""
"Pressure above or below the threshold will be clamped, and this becomes the "
"new effective range."
msgstr ""
"Pritisk nad ali pod pragom bo omejen in to postane novo efektivno območje."

#: ui/StylusTab.qml:461
#, kde-format
msgctxt "@info"
msgid ""
"You have manually calibrated this tablet. If it's no longer working "
"correctly, try resetting this first."
msgstr ""
"Ta tablični računalnik ste umerili ročno. Če ne deluje več pravilno, ga "
"poskusite najprej ponastaviti."

#: ui/StylusTab.qml:470
#, kde-format
msgctxt "@action:button Calibration in progress"
msgid "Calibration in Progress"
msgstr "Umerjanje v teku"

#: ui/StylusTab.qml:472
#, kde-format
msgctxt "@action:button Calibrate the pen display"
msgid "Calibrate"
msgstr "Umeri"

#: ui/StylusTab.qml:475
#, kde-format
msgctxt "@action:button Pen display doesn't support calibration"
msgid "Calibration Not Supported"
msgstr "Umerjanje ni podprto"

#: ui/StylusTab.qml:516
#, kde-format
msgctxt "@action:button"
msgid "Reset Custom Calibration"
msgstr "Ponastavi umerjanje po meri"

#: ui/Tester.qml:25
#, kde-format
msgctxt "@title"
msgid "Tablet Tester"
msgstr "Preizkuševalnik tablice"

#: ui/Tester.qml:48
#, kde-format
msgctxt ""
"A tablet stylus was pressed onto the surface X=[x position] Y=[y position]"
msgid "Stylus press X=%1 Y=%2"
msgstr "Pritisnite pisalo X=%1 Y=%2"

#: ui/Tester.qml:58
#, kde-format
msgctxt ""
"A tablet stylus has 'released' or was lifted from the surface X=[x position] "
