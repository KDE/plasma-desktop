#: ui/Calibration.qml:32
#, kde-format
msgctxt "@title"
msgid "Pen Calibration"
msgstr "Umerjanje peresa"

#: ui/Calibration.qml:73
#, kde-format
msgctxt "@info"
msgid "%1: (%2 px, %3 px)"
msgstr "%1: (%2 px, %3 px)"

#: ui/Calibration.qml:107
#, kde-format
msgctxt "@info"
msgid ""
"Applied center correction (%1 px, %2 px). Retap the targets to redo the "
"correction."
msgstr ""
"Uporabljena je bila korekcija središča (%1 px, %2 px). Za ponovitev "
"korekcije se ponovno dotaknite tarč."

#: ui/Calibration.qml:173
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Tap the targets again to confirm the new calibration.<nl/><nl/><emphasis "
"strong='true'>Will revert to default calibration in %1 seconds unless "
"further action is taken.</emphasis>"
msgstr ""
"Za potrditev nove kalibracije se znova dotaknite tarč.<nl/><nl/><emphasis "
"strong='true'>Kalibracija se bo vrnila na privzeto vrednost čez %1 sekundo, "
"če ne boste ukrepali.</emphasis>"

#: ui/Calibration.qml:177
#, kde-format
msgctxt "@info"
msgid ""
"Calibration is completed and saved.\n"
"\n"
"Tap the center target once to fine-tune alignment. You can retap the other "
"targets to verify the result."
msgstr ""
"Kalibracija je končana in shranjena.\n"
"\n"
"Za natančno poravnavo enkrat dotaknite sredinsko tarčo. Rezultat lahko "
"preverite z dodatnimi dotiki."

#: ui/Calibration.qml:180
#, kde-format
msgctxt "@info"
msgid "Tap the center of each target."
msgstr "Tapnite sredino vsake tarče."

#: ui/Calibration.qml:201
#, kde-format
msgctxt "@info"
msgid ""
"Offset Correction:\n"
"%1"
msgstr ""
"Popravek odmika:\n"
"%1"

#: ui/Calibration.qml:216
#, kde-format
