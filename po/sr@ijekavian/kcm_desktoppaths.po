#: ui/main.qml:137
#, kde-format
msgctxt "@label:textbox"
msgid "Public folder:"
msgstr "Јавна фасцикла:"

#: ui/main.qml:143
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid ""
"This folder will be used by default for publicly-shared files when network "
"sharing is enabled."
msgstr ""
"Ова фасцикла се користи као подразумијевана за јавно дијељене фајлове када "
"је укључено мрежно дијељење."

#: ui/main.qml:151
#, kde-format
msgctxt "@label:textbox"
msgid "Templates folder:"
msgstr "Фасцикла шаблона:"

