#: ui/main.qml:53
#, kde-format
msgctxt "@label:textbox"
msgid "Desktop folder:"
msgstr "Фасцикла површи:"

#: ui/main.qml:59
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder contains all the files you see on your desktop."
msgstr "Ова фасцикла садржи све фајлове које видите на површи."

#: ui/main.qml:67
#, kde-format
msgctxt "@label:textbox"
msgid "Documents folder:"
msgstr "Фасцикла докумената:"

#: ui/main.qml:73
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to open or save documents."
msgstr ""
"Ова фасцикла се користи као подразумијевана за отварање или уписивање "
"докумената."

#: ui/main.qml:81
#, kde-format
msgctxt "@label:textbox"
msgid "Downloads folder:"
msgstr "Фасцикла преузимања:"

#: ui/main.qml:87
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder will be used by default to save your downloaded items."
msgstr ""
"Ова фасцикла се користи као подразумијевана за уписивање преузетих ставки."

#: ui/main.qml:95
#, kde-format
msgctxt "@label:textbox"
msgid "Videos folder:"
msgstr "Фасцикла видео снимака:"

